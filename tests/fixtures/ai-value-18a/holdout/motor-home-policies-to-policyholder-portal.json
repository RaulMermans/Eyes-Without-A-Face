    "customer_code": {
      "source": "cod_cli",
      "why": "codice cliente; num_pol is the policy number"
    },
    "full_name": {
      "source": "nom_cont",
      "why": "contraente (policyholder) name; rag_soc is a company name"
    },
    "date_of_birth": {
      "source": "dt_nasc",
      "dateFormat": "DD/MM/YYYY",
      "why": "data di nascita; dt_dec is policy start (decorrenza)"
    },
    "email": {
      "source": "eml_pers",
      "why": "personal email; eml_agt is the agent"
    },
    "mobile_phone": {
      "source": "tel_cell",
      "why": "cellulare; fax is fax"
    },
    "postal_code": {
      "source": "cap",
      "why": "CAP = postal code; cod_ag is the agency code"
    },
    "customer_status": {
      "source": "st_cli",
      "why": "customer state; st_pag is premium payment state"
    },
    "primary_policy_type": {
      "source": "tp_pol",
