      "source": "correo",
      "why": "only email"
    },
    "postal_code": {
      "source": "codigo_postal",
      "why": "postal code; codigo_centro is internal clinic code"
    },
    "status": {
      "source": "estado_paciente",
      "why": "patient state; estado_cita is the appointment state"
    },
    "emergency_contact_name": {
      "source": "contacto_emergencia.nombre",
