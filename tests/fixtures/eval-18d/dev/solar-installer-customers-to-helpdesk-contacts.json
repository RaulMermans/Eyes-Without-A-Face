  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "description": "Your own identifier for the customer, used to match future imports."
      },
      "first_name": {
        "type": "string",
        "description": "Given name of the contact."
      },
      "last_name": {
        "type": "string",
        "description": "Family name of the contact."
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Primary email address of the contact; ticket replies are sent here."
      },
      "phone": {
        "type": "string"
      },
      "organization": {
        "type": "string",
        "description": "Name of the company the contact belongs to, if any."
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "suspended",
          "closed"
        ],
        "description": "Status."
      },
      "plan": {
        "type": "string",
        "enum": [
          "basic",
          "plus",
          "premium"
        ],
        "description": "Service plan the customer pays for, which sets what support covers."
      },
      "customer_since": {
        "type": "string",
        "format": "date",
        "description": "Date on which the person became a paying customer."
      },
      "time_zone": {
        "type": "string",
        "description": "Time zone used to schedule callbacks to the contact."
      }
    },
    "required": [
      "external_id",
      "first_name",
      "last_name",
      "email",
      "status"
    ]
  },
  "groundTruth": {
    "external_id": {
      "source": "customer_number",
      "transform": "copy",
      "why": "customer number; record_id is the CRM's internal key and legacy_id an old system key"
    },
    "first_name": {
      "source": "properties.firstname",
      "transform": "copy",
      "why": "contact given name; owner_name is the sales rep"
    },
    "last_name": {
      "source": "properties.lastname",
      "transform": "trim",
      "why": "contact family name, padded in some rows"
    },
    "email": {
      "source": "properties.email",
      "transform": "normalize_email",
      "why": "personal email, mixed case; billing_email is the accounts-payable address"
    },
    "phone": {
      "source": "properties.phone",
      "transform": "copy",
      "why": "contact phone, null or missing for some"
    },
    "organization": {
      "source": "associated_company.name",
      "transform": "copy",
      "why": "associated company; residential customers have none"
    },
    "status": {
      "source": "properties.account_status",
      "transform": "map_enum",
      "categoryMap": {
        "Active - Installed": "active",
        "Active - Install Scheduled": "active",
        "On Hold": "suspended",
        "Cancelled": "closed",
        "Test record": null
      },
      "why": "lifecycle state of the customer account; test records are not customers and need review"
    },
    "plan": {
      "source": "properties.service_plan",
      "transform": "map_enum",
      "categoryMap": {
        "Monitoring Only": "basic",
        "Monitoring + Cleaning": "plus",
        "Total Care": "premium"
      },
      "why": "service plan; segment is a market segment, not a plan"
    },
    "customer_since": {
      "source": "properties.contract_signed_date",
      "transform": "parse_date",
      "dateFormat": "MM/DD/YYYY",
      "why": "contract signature date (US month-first); createdate is when the lead was created"
    },
    "time_zone": {
      "source": null,
      "transform": "none",
      "why": "no time zone is exported; the state alone is not a supported transformation"
    }
  },
