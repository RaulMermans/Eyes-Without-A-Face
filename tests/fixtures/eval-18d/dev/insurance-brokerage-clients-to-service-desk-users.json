  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "description": "Identifier of the user in the system of record."
      },
      "profile": {
        "type": "object",
        "description": "Personal details of the user.",
        "properties": {
          "first_name": {
            "type": "string",
            "description": "Given name of the user."
          },
          "last_name": {
            "type": "string",
            "description": "Family name or names of the user."
          },
          "locale": {
            "type": "string",
            "enum": [
              "es-ES",
              "ca-ES",
              "en-GB"
            ],
            "description": "Locale used for notifications to the user."
          }
        },
        "required": [
          "first_name",
          "last_name"
        ]
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Main email address of the user."
      },
      "phone": {
        "type": "string",
        "description": "Phone number of the user."
      },
      "organization": {
        "type": "string",
        "description": "Name."
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "suspended",
          "closed"
        ],
        "description": "Whether the customer relationship is active, suspended or closed."
      },
      "support_tier": {
        "type": "string",
        "enum": [
          "gold",
          "silver",
          "bronze"
        ],
        "description": "Service level agreed with the client, which sets response targets."
      },
      "customer_since": {
        "type": "string",
        "format": "date",
        "description": "Date the client relationship started."
      },
      "notes": {
        "type": "string"
      }
    },
    "required": [
      "external_id",
      "profile",
      "email",
      "status",
      "support_tier"
    ]
  },
  "groundTruth": {
    "external_id": {
      "source": "IdCliente",
      "transform": "copy",
      "why": "client number; NumeroPoliza is one of the client's policies"
    },
    "profile.first_name": {
      "source": "Contacto.Nombre",
      "transform": "copy",
      "why": "given name; Agente is the broker"
    },
    "profile.last_name": {
      "source": "Contacto.Apellidos",
      "transform": "trim",
      "why": "family names, padded"
    },
    "profile.locale": {
      "source": "Idioma",
      "transform": "map_enum",
      "categoryMap": {
        "Español": "es-ES",
        "Catalán": "ca-ES",
        "Inglés": "en-GB"
      },
      "why": "preferred language as locale"
    },
    "email": {
      "source": "Contacto.Correo.Principal",
      "transform": "copy",
      "why": "main email; Facturacion is the billing address"
    },
    "phone": {
      "source": "Contacto.Telefono",
      "transform": "copy",
      "why": "phone, null or missing for some"
    },
    "organization": {
      "source": "Empresa.RazonSocial",
      "transform": "copy",
      "why": "company name for business clients; null or missing for private clients"
    },
    "status": {
      "source": "EstadoCuenta",
      "transform": "map_enum",
      "categoryMap": {
        "Activo": "active",
        "Baja voluntaria": "closed",
        "Suspendido por impago": "suspended",
        "Prospecto": null
      },
      "why": "relationship state; prospects are not clients and need review; EstadoPago is the premium payment state"
    },
    "support_tier": {
      "source": "NivelServicio",
      "transform": "map_enum",
      "categoryMap": {
        "Oro": "gold",
        "Plata": "silver",
        "Bronce": "bronze",
        "VIP Dirección": "gold"
      },
      "why": "service level; Segmento is a market segment"
    },
    "customer_since": {
      "source": "FechaAlta",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "sign-up date (Spanish day-first); FechaRenovacion is the next renewal"
    },
    "notes": {
      "source": null,
      "transform": "none",
      "why": "no free-text notes are exported"
    }
  },
