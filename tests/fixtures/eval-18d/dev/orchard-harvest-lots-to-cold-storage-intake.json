  "groundTruth": {
    "lot_id": {
      "source": "lotto.codice",
      "transform": "copy",
      "why": "lot code; bolla_n is the delivery note, riga the row"
    },
    "grower_code": {
      "source": "socio.codice",
      "transform": "copy",
      "why": "member code"
    },
    "grower_name": {
      "source": "socio.ragione_sociale",
      "transform": "trim",
      "why": "farm name, padded; referente is a person"
    },
    "variety": {
      "source": "varieta",
      "transform": "map_enum",
      "categoryMap": {
        "Golden Delicious": "golden",
        "Fuji": "fuji",
        "Gala": "gala",
        "Renetta Canada": "renetta",
        "Campione interno": null
      },
      "why": "variety; internal samples are not member lots and need review"
    },
    "quality_grade": {
      "source": "categoria_qualita",
      "transform": "map_enum",
      "categoryMap": {
        "Extra": "extra",
        "I cat.": "class_1",
        "II cat.": "class_2",
        "Industria": "processing"
      },
      "why": "quality class; calibro is a size class"
    },
    "harvested_on": {
      "source": "data_raccolta",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "harvest date (Italian day-first); conferimento is the delivery date"
    },
    "net_weight_kg": {
      "source": "peso_netto_kg",
      "transform": "copy",
      "why": "net weight; lordo includes bins"
    },
    "storage_room": {
      "source": "cella",
      "transform": "copy",
      "why": "cold room, null or missing"
    },
    "estimated_value_eur": {
      "source": null,
      "transform": "none",
      "why": "not exported",
      "unsupportedReason": "would need net weight multiplied by prezzo_kg"
    }
  },
