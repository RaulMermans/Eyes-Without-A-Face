  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "externalId": {
        "type": "string",
        "description": "Identifier of the requester in the subscription platform."
      },
      "fullName": {
        "type": "string",
        "description": "Full name of the requester, given name first."
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Email address of the requester."
      },
      "phone": {
        "type": "string",
        "description": "Mobile."
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "paused",
          "cancelled"
        ],
        "description": "Lifecycle state of the requester's account."
      },
      "plan": {
        "type": "string",
        "enum": [
          "classic_2",
          "family_4",
          "veggie_2"
        ],
        "description": "Meal plan of the requester."
      },
      "contactChannel": {
        "type": "string",
        "enum": [
          "sms",
          "email",
          "phone"
        ],
        "description": "Channel the requester prefers for proactive contact."
      },
      "customerSince": {
        "type": "string",
        "format": "date",
        "description": "Date the requester signed up."
      },
      "loyaltyTier": {
        "type": "string",
        "enum": [
          "bronze",
          "silver",
          "gold"
        ]
      }
    },
    "required": [
      "externalId",
      "fullName",
      "email",
      "status",
      "plan",
      "customerSince"
    ]
  },
  "groundTruth": {
    "externalId": {
      "source": "id_cli",
      "transform": "copy",
      "why": "customer id; id_enc_ult is the last order"
    },
    "fullName": {
      "source": null,
      "sources": [
        "primeiro_nome",
        "apelido"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "given name and surname; nutricionista is staff"
    },
    "email": {
      "source": "email",
      "transform": "normalize_email",
      "why": "email, mixed case; email_fatura is invoicing"
    },
    "phone": {
      "source": "telemovel",
      "transform": "copy",
      "why": "mobile, null or missing"
    },
    "status": {
      "source": "estado_conta",
      "transform": "map_enum",
      "categoryMap": {
        "Ativa": "active",
        "Pausada": "paused",
        "Cancelada": "cancelled",
        "Conta de teste": null
      },
      "why": "account state; test accounts need review"
    },
    "plan": {
      "source": "plano",
      "transform": "map_enum",
      "categoryMap": {
        "Clássico 2 pessoas": "classic_2",
        "Família 4 pessoas": "family_4",
        "Vegetariano 2 pessoas": "veggie_2"
      },
      "why": "plan"
    },
    "contactChannel": {
      "source": "preferencia_contacto",
      "transform": "map_enum",
      "categoryMap": {
        "SMS": "sms",
        "E-mail": "email",
        "Telefone": "phone"
      },
      "why": "contact preference"
    },
    "customerSince": {
      "source": "data_registo",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "sign-up date (day-first); null in a few rows, which are held"
    },
    "loyaltyTier": {
      "source": null,
      "transform": "none",
      "why": "no loyalty tier is exported"
    }
  },
