  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "requester": {
        "type": "object",
        "description": "Person who contacts support.",
        "properties": {
          "external_id": {
            "type": "string",
            "description": "Identifier of the requester in the source system."
          },
          "name": {
            "type": "string",
            "description": "Full name of the requester as used in Mexico: given name, paternal and maternal surname."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the requester."
          },
          "phone": {
            "type": "string",
            "description": "Office phone of the requester."
          }
        },
        "required": [
          "external_id",
          "name",
          "email"
        ]
      },
      "organization": {
        "type": "object",
        "description": "Corporate account of the requester.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Legal name of the corporate account."
          },
          "account_status": {
            "type": "string",
            "enum": [
              "active",
              "blocked",
              "closed"
            ],
            "description": "Status."
          },
          "tier": {
            "type": "string",
            "enum": [
              "tier_a",
              "tier_b",
              "government"
            ],
            "description": "Commercial agreement tier of the account."
          },
          "customer_since": {
            "type": "string",
            "format": "date",
            "description": "Date the corporate account was opened."
          }
        },
        "required": [
          "name",
          "account_status"
        ]
      },
      "time_zone": {
        "type": "string",
        "enum": [
          "America/Mexico_City",
          "America/Mazatlan",
          "America/Tijuana"
        ],
        "description": "Time zone in which the requester works."
      },
      "notes": {
        "type": "string"
      }
    },
    "required": [
      "requester",
      "organization"
    ]
  },
  "groundTruth": {
    "requester.external_id": {
      "source": "id_contacto",
      "transform": "copy",
      "why": "contact id; num_cta identifies the account"
    },
    "requester.name": {
      "source": null,
      "sources": [
        "cta.contacto.nombre",
        "cta.contacto.apellido_paterno",
        "cta.contacto.apellido_materno"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "three name parts; ejecutivo is the account executive"
    },
    "requester.email": {
      "source": "cta.contacto.correo",
      "transform": "normalize_email",
      "why": "contact email, mixed case; correo_cxp is accounts payable"
    },
    "requester.phone": {
      "source": "cta.contacto.tel_oficina",
      "transform": "copy",
      "why": "office phone, null or missing"
    },
    "organization.name": {
      "source": "cta.razon_social",
      "transform": "copy",
      "why": "account legal name"
    },
    "organization.account_status": {
      "source": "cta.estatus",
      "transform": "map_enum",
      "categoryMap": {
        "Vigente": "active",
        "Bloqueada por crédito": "blocked",
        "Cancelada": "closed",
        "Prueba": null
      },
      "why": "account state; test accounts need review; estatus_credito is credit"
    },
    "organization.tier": {
      "source": "cta.convenio",
      "transform": "map_enum",
      "categoryMap": {
        "Tarifa Corporativa A": "tier_a",
        "Tarifa Corporativa B": "tier_b",
        "Gobierno": "government"
      },
      "why": "agreement"
    },
    "organization.customer_since": {
      "source": "fecha_alta",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "opening date (day-first); fecha_renovacion is renewal"
    },
    "time_zone": {
      "source": "zona_horaria",
      "transform": "map_enum",
      "categoryMap": {
        "Centro": "America/Mexico_City",
        "Pacífico": "America/Mazatlan",
        "Noroeste": "America/Tijuana"
      },
      "why": "Mexican zone names"
    },
    "notes": {
      "source": null,
      "transform": "none",
      "why": "no notes are exported"
    }
  },
