  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ticket_id": {
        "type": "string",
        "description": "Unique code printed on the ticket and read at the gate."
      },
      "attendee_name": {
        "type": "string",
        "description": "Name of the person who will use the ticket."
      },
      "ticket_type": {
        "type": "string",
        "enum": [
          "weekend",
          "saturday",
          "sunday",
          "vip_weekend"
        ],
        "description": "Kind of admission the ticket grants."
      },
      "gate": {
        "type": "string",
        "enum": [
          "north",
          "river",
          "vip"
        ],
        "description": "Gate."
      },
      "valid_from": {
        "type": "string",
        "format": "date",
        "description": "First day on which the ticket admits entry."
      },
      "contact_email": {
        "type": "string",
        "format": "email",
        "description": "Email for urgent event updates about this ticket."
      },
      "access_requirement": {
        "type": "string",
        "enum": [
          "wheelchair",
          "companion",
          "step_free"
        ],
        "description": "Accessibility arrangement booked with the ticket, if any."
      },
      "days_until_event": {
        "type": "integer"
      }
    },
    "required": [
      "ticket_id",
      "attendee_name",
      "ticket_type",
      "valid_from"
    ]
  },
  "groundTruth": {
    "ticket_id": {
      "source": "ticket.barcode",
      "transform": "copy",
      "why": "ticket barcode; order.ref covers several tickets"
    },
    "attendee_name": {
      "source": "attendee.name",
      "transform": "trim",
      "why": "attendee name, padded; buyer.name bought it"
    },
    "ticket_type": {
      "source": "ticket.type",
      "transform": "map_enum",
      "categoryMap": {
        "Weekend Pass": "weekend",
        "Saturday Only": "saturday",
        "Sunday Only": "sunday",
        "VIP Weekend": "vip_weekend",
        "Crew Wristband": null
      },
      "why": "ticket type; crew passes are not tickets and need review"
    },
    "gate": {
      "source": "ticket.entry_gate",
      "transform": "map_enum",
      "categoryMap": {
        "North Gate": "north",
        "River Gate": "river",
        "VIP Lane": "vip"
      },
      "why": "assigned gate"
    },
    "valid_from": {
      "source": "ticket.valid_from",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "valid-from (UK day-first); placed_at is the order time"
    },
    "contact_email": {
      "source": "buyer.email",
      "transform": "normalize_email",
      "why": "buyer email, mixed case, null or missing"
    },
    "access_requirement": {
      "source": "ticket.access_need",
      "transform": "map_enum",
      "categoryMap": {
        "Wheelchair space": "wheelchair",
        "Companion ticket": "companion",
        "Step-free route": "step_free"
      },
      "why": "access need, null or missing"
    },
    "days_until_event": {
      "source": null,
      "transform": "none",
      "why": "not exported",
      "unsupportedReason": "would need the difference between valid_from and today"
    }
  },
  "confusablePairs": [
    {
      "kind": "nested-entity-relationship",
      "fields": [
