      },
      "why": "site"
    },
    "plot_use": {
      "source": "tuintype",
      "transform": "map_enum",
      "categoryMap": {
        "Moestuin": "vegetables",
        "Siertuin": "ornamental",
        "Gemengd": "mixed"
      },
      "why": "garden type"
    },
    "lease_status": {
      "source": "status_huur",
      "transform": "map_enum",
      "categoryMap": {
        "Verhuurd": "leased",
        "Opgezegd": "terminated",
        "Wachtlijst": "waiting",
        "Proeftuin vereniging": null
      },
      "why": "lease state; the association's own trial plot needs review"
    },
    "lease_start": {
      "source": "startdatum",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "lease start (Dutch day-first)"
    },
