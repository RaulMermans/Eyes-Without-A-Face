      "transform": "trim",
      "why": "tenant, padded; tuincommissie is the inspector"
    },
    "tenant_email": {
      "source": "huurder.email",
      "transform": "normalize_email",
      "why": "email, mixed case, null or missing"
    },
    "site": {
