  "groundTruth": {
    "organization.external_id": {
      "source": "c_code_client",
      "transform": "copy",
      "why": "client code; num_entreprise is the company registry number"
    },
    "organization.name": {
      "source": "c_raison_sociale",
      "transform": "trim",
      "why": "company name, padded"
    },
    "contact_name": {
      "source": null,
      "sources": [
        "c_contact_prenom",
        "c_contact_nom"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "contact given and family name; expert_comptable is the firm's accountant"
    },
    "email": {
      "source": "c_email_contact",
      "transform": "copy",
      "why": "contact email; email_facturation is the invoicing mailbox"
    },
    "phone": {
      "source": "c_tel",
      "transform": "copy",
      "why": "phone, null in some rows"
    },
    "status": {
      "source": "c_statut_dossier",
      "transform": "map_enum",
      "categoryMap": {
        "En cours": "active",
        "Suspendu": "on_hold",
        "Résilié": "terminated",
        "Prospect": null
      },
      "why": "engagement state; prospects need review; statut_reglement is payment"
    },
    "service": {
      "source": "c_mission",
      "transform": "map_enum",
      "categoryMap": {
        "Tenue comptable": "bookkeeping",
        "Révision": "audit",
        "Social / paie": "payroll",
        "Juridique annuel": "legal"
      },
      "why": "engagement type; regime_tva is a VAT regime"
    },
    "language": {
      "source": "c_langue",
      "transform": "map_enum",
      "categoryMap": {
        "FR": "fr",
        "NL": "nl",
        "EN": "en"
      },
      "why": "language, null or missing"
    },
    "customer_since": {
      "source": "c_date_entree",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "engagement start (day-first); date_cloture is the fiscal year end"
    },
    "priority": {
      "source": null,
      "transform": "none",
      "why": "no support priority is exported"
    }
  },
