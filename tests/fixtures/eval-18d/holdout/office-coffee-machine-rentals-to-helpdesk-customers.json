  "groundTruth": {
    "external_id": {
      "source": "CodiceCliente",
      "transform": "copy",
      "why": "customer code; IdAnagrafica is the CRM record key"
    },
    "first_name": {
      "source": "Referente.Nome",
      "transform": "copy",
      "why": "contact given name; Tecnico is the service technician"
    },
    "last_name": {
      "source": "Referente.Cognome",
      "transform": "copy",
      "why": "contact family name"
    },
    "email": {
      "source": "Referente.Email",
      "transform": "normalize_email",
      "why": "contact email, mixed case; AmministrazioneEmail is accounts"
    },
    "mobile": {
      "source": "Referente.Cellulare",
      "transform": "copy",
      "why": "mobile, null or missing"
    },
    "organization": {
      "source": "RagioneSociale",
      "transform": "trim",
      "why": "company, padded"
    },
    "status": {
      "source": "StatoCliente",
      "transform": "map_enum",
      "categoryMap": {
        "Attivo": "active",
        "Sospeso": "suspended",
        "Disdetto": "cancelled",
        "Bozza": null
      },
      "why": "customer state; drafts need review"
    },
    "plan": {
      "source": "Contratto.Formula",
      "transform": "map_enum",
      "categoryMap": {
        "Comodato d'uso": "loan",
        "Noleggio Smart": "smart",
        "Noleggio Premium": "premium"
      },
      "why": "contract formula"
    },
    "priority": {
      "source": "Priorita",
      "transform": "map_enum",
      "categoryMap": {
        "Alta": "high",
        "Normale": "normal",
        "Bassa": "low"
      },
      "why": "priority"
    },
    "customer_since": {
      "source": "Contratto.Decorrenza",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "effective date (day-first); Scadenza is the expiry"
    },
    "language": {
      "source": null,
      "transform": "none",
      "why": "no language is exported"
    }
  },
