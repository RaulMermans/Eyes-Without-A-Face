  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "description": "Identifier of the requester in your own records."
      },
      "first_name": {
        "type": "string",
        "description": "Given name of the requester."
      },
      "last_name": {
        "type": "string",
        "description": "Family name of the requester."
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Primary email address; replies to tickets go here."
      },
      "phone": {
        "type": "string",
        "description": "Mobile phone number for text updates."
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "paused",
          "cancelled"
        ],
        "description": "Status."
      },
      "plan": {
        "type": "string",
        "enum": [
          "full_service",
          "chemicals_only",
          "seasonal"
        ],
        "description": "Service plan the requester subscribes to."
      },
      "preferred_channel": {
        "type": "string",
        "enum": [
          "sms",
          "phone",
          "email"
        ],
        "description": "How the requester prefers to be contacted."
      },
      "customer_since": {
        "type": "string",
        "format": "date",
        "description": "Date the requester became a customer."
      },
      "company": {
        "type": "string"
      }
    },
    "required": [
      "external_id",
      "first_name",
      "last_name",
      "email",
      "status"
    ]
  },
  "groundTruth": {
    "external_id": {
      "source": "Client_ID",
      "transform": "copy",
      "why": "client id; Invoice_Acct_No is the billing account"
    },
    "first_name": {
      "source": "First_Name",
      "transform": "trim",
      "why": "given name, padded; Route_Tech is the technician"
    },
    "last_name": {
      "source": "Last_Name",
      "transform": "copy",
      "why": "family name"
    },
    "email": {
      "source": "Email",
      "transform": "normalize_email",
      "why": "primary email, mixed case; Alt_Email is secondary"
    },
    "phone": {
      "source": "Cell",
      "transform": "copy",
      "why": "cell phone, null or missing"
    },
    "status": {
      "source": "Account_Status",
      "transform": "map_enum",
      "categoryMap": {
        "Active": "active",
        "Seasonal Hold": "paused",
        "Cancelled": "cancelled",
        "DUPLICATE - see other row": null
      },
      "why": "account state; duplicates need review"
    },
    "plan": {
      "source": "Plan",
      "transform": "map_enum",
      "categoryMap": {
        "Weekly Full Service": "full_service",
        "Bi-Weekly Chem Only": "chemicals_only",
        "Opening/Closing Only": "seasonal"
      },
      "why": "service plan"
    },
    "preferred_channel": {
      "source": "Preferred_Contact",
      "transform": "map_enum",
      "categoryMap": {
        "Text": "sms",
        "Call": "phone",
        "Email": "email"
      },
      "why": "preferred contact channel, null or missing"
    },
    "customer_since": {
      "source": "Start_Date",
      "transform": "parse_date",
      "dateFormat": "MM/DD/YYYY",
      "why": "service start (US month-first); Last_Visit is the latest visit"
    },
    "company": {
      "source": null,
      "transform": "none",
      "why": "residential clients; no company is exported"
    }
  },
  "confusablePairs": [
    {
      "kind": "competing-category-fields",
      "fields": [
        "Account_Status",
        "Billing_Status"
      ],
      "correctFor": "status"
    },
    {
      "kind": "customer-id-vs-transaction-id",
      "fields": [
        "Client_ID",
