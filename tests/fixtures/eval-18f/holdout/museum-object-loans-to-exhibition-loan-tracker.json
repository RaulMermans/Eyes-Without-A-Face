  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "loan_id": {
        "type": "string",
        "description": "Identifier of the loan agreement."
      },
      "object_number": {
        "type": "string",
        "description": "Lender's catalogue number of the borrowed object."
      },
      "object_title": {
        "type": "string",
        "description": "Title of the borrowed object."
      },
      "lender": {
        "type": "string",
        "description": "Institution or collection lending the object."
      },
      "status": {
        "type": "string",
        "enum": [
          "requested",
          "confirmed",
          "on_site",
          "returned"
        ],
        "description": "Stage the loan has reached."
      },
      "cover_type": {
        "type": "string",
        "enum": [
          "indemnity",
          "commercial",
          "lender"
        ],
        "description": "How the object is insured while on loan."
      },
      "insured_value": {
        "type": "number",
        "description": "Value."
      },
      "start_date": {
        "type": "string",
        "format": "date",
        "description": "First day of the loan period."
      },
      "end_date": {
        "type": "string",
        "format": "date",
        "description": "Last day of the loan period."
      },
      "height_cm": {
        "type": "number",
        "description": "Height of the object in centimetres."
      },
      "loan_days": {
        "type": "integer",
        "description": "Length of the loan period in days."
      },
      "gallery": {
        "type": "string"
      }
    },
    "required": [
      "loan_id",
      "object_number",
      "object_title",
      "lender",
      "status",
      "cover_type",
      "start_date"
    ]
  },
  "groundTruth": {
    "loan_id": {
      "source": "loan_ref",
      "transform": "copy",
      "why": "loan reference; export_row is the row counter"
    },
    "object_number": {
      "source": "object.accession_no",
      "transform": "copy",
      "why": "lender's accession number"
    },
    "object_title": {
      "source": "object.title",
      "transform": "trim",
      "why": "object title, padded"
    },
    "lender": {
      "source": "lender.institution",
      "transform": "copy",
      "why": "lending institution; lender.contact_name is a person there and registrar is staff"
    },
    "status": {
      "source": "loan_status",
      "transform": "map_enum",
      "categoryMap": {
        "Agreement sent": "requested",
        "Agreed": "confirmed",
        "In transit": "confirmed",
        "On display": "on_site",
        "Returned": "returned",
        "Withdrawn": null
      },
      "why": "loan stage; withdrawn loans need review"
    },
    "cover_type": {
      "source": "indemnity_cover",
      "transform": "map_enum",
      "categoryMap": {
        "Government Indemnity": "indemnity",
        "Commercial policy": "commercial",
        "Lender's own": "lender"
      },
      "why": "insurance cover; courier_required is a different yes/no category"
    },
    "insured_value": {
      "source": "insurance_value_gbp",
      "transform": "copy",
      "why": "insurance value, null or missing for some; acquisition_price_gbp is what the lender paid"
    },
    "start_date": {
      "source": "loan_start",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "loan start (UK day-first); condition_checked is the last condition report"
    },
    "end_date": {
      "source": "loan_end",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "loan end (UK day-first)"
    },
    "height_cm": {
      "source": "object.dimensions.height_cm",
      "transform": "copy",
      "why": "height; width_cm is the width"
    },
    "loan_days": {
      "source": null,
      "transform": "none",
      "why": "not exported",
      "unsupportedReason": "would need the number of days between loan_start and loan_end"
    },
    "gallery": {
      "source": null,
      "transform": "none",
      "why": "no gallery is exported"
    }
  },
