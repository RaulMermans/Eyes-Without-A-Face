  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "externalId": {
        "type": "string",
        "description": "Identifier of the customer in the marina's own records."
      },
      "firstName": {
        "type": "string",
        "description": "Given name of the end user."
      },
      "lastName": {
        "type": "string",
        "description": "Family name of the end user."
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Main email address of the end user; required to raise requests."
      },
      "phone": {
        "type": "string",
        "description": "Mobile number of the end user."
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "seasonal",
          "inactive"
        ],
        "description": "Whether the customer currently holds a berth, holds one seasonally, or has left."
      },
      "boatType": {
        "type": "string",
        "enum": [
          "sail",
          "power"
        ],
        "description": "Type."
      },
      "customerSince": {
        "type": "string",
        "format": "date",
        "description": "Date the customer's first berth agreement began."
      },
      "preferredLanguage": {
        "type": "string"
      },
      "membershipYears": {
        "type": "integer",
        "description": "Number of full years the customer has held a berth."
      }
    },
    "required": [
      "externalId",
      "firstName",
      "lastName",
      "email",
      "status"
    ]
  },
  "groundTruth": {
    "externalId": {
      "source": "MemberRef",
      "transform": "copy",
      "why": "berth-holder reference; LegacyRef is an old system key and RowNo the export row"
    },
    "firstName": {
      "source": "Forename",
      "transform": "copy",
      "why": "given name; HarbourMaster is staff"
    },
    "lastName": {
      "source": "Surname",
      "transform": "trim",
      "why": "family name, padded"
    },
    "email": {
      "source": "EmailAddress",
      "transform": "normalize_email",
      "why": "main email, mixed case; null in a few rows, which are held; AltEmail is a secondary work address"
    },
    "phone": {
      "source": "MobileTel",
      "transform": "copy",
      "why": "mobile, null or missing for some"
    },
    "status": {
      "source": "BerthStatus",
      "transform": "map_enum",
      "categoryMap": {
        "Annual Berth": "active",
        "Winter Lay-up": "seasonal",
        "Visitor - Seasonal": "seasonal",
        "Left Marina": "inactive",
        "Waiting List": null
      },
      "why": "berth state; people on the waiting list are not customers yet and need review; PaymentStatus is the fee state"
    },
    "boatType": {
      "source": "VesselType",
      "transform": "map_enum",
      "categoryMap": {
        "Sailing Yacht": "sail",
