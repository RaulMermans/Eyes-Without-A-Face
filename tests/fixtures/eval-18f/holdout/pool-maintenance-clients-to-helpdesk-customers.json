  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "externalId": {
        "type": "string",
        "description": "Identifier of the customer in the company's own records."
      },
      "name": {
        "type": "string",
        "description": "Full name of the customer."
      },
      "contact": {
        "type": "object",
        "description": "How to reach the customer.",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Personal email address of the customer."
          },
          "phone": {
            "type": "string",
            "description": "Mobile number of the customer."
          }
        },
        "required": [
          "email"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "paused",
          "cancelled"
        ],
        "description": "Account state of the customer."
      },
      "plan": {
        "type": "string",
        "enum": [
          "biweekly",
          "weekly",
          "winter_only"
        ],
        "description": "Visit plan the customer subscribes to."
      },
      "poolType": {
        "type": "string",
        "enum": [
          "outdoor",
          "indoor",
          "shared"
        ],
        "description": "Kind of pool that is maintained."
      },
      "customerSince": {
        "type": "string",
        "format": "date",
        "description": "Date the customer joined."
      },
      "preferredVisitDay": {
        "type": "string"
      },
      "poolVolumeLitres": {
        "type": "number",
        "description": "Volume."
      }
    },
    "required": [
      "externalId",
      "name",
      "contact",
      "status",
      "plan"
    ]
  },
  "groundTruth": {
    "externalId": {
      "source": "codigoCliente",
      "transform": "copy",
      "why": "client code; nifCliente is the tax number and linha the export row"
    },
    "name": {
      "source": "cliente.nomeCompleto",
      "transform": "trim",
      "why": "full name, padded; tecnico is the technician"
    },
    "contact.email": {
      "source": "cliente.email",
      "transform": "normalize_email",
      "why": "personal email, mixed case and padded; emailFaturacao is for invoices"
    },
    "contact.phone": {
      "source": "cliente.telemovel",
      "transform": "copy",
      "why": "mobile, null or missing for some"
    },
    "status": {
      "source": "estadoConta",
      "transform": "map_enum",
      "categoryMap": {
        "Ativo": "active",
        "Ativo - época alta": "active",
        "Suspenso": "paused",
        "Cancelado": "cancelled",
        "Orçamento": null
      },
      "why": "account state; a quote is not a customer yet; estadoPagamento is payment"
    },
    "plan": {
      "source": "plano",
      "transform": "map_enum",
      "categoryMap": {
        "Visita quinzenal": "biweekly",
        "Visita semanal": "weekly",
        "Só inverno": "winter_only"
      },
      "why": "visit plan"
    },
    "poolType": {
      "source": "tipoPiscina",
      "transform": "map_enum",
      "categoryMap": {
        "Exterior": "outdoor",
        "Interior aquecida": "indoor",
        "Condomínio": "shared"
      },
      "why": "pool type, null or missing for some"
    },
    "customerSince": {
      "source": "dataAdesao",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "join date (Portuguese day-first); dataProximaVisita is the next visit"
    },
    "preferredVisitDay": {
      "source": null,
      "transform": "none",
      "why": "not exported"
    },
    "poolVolumeLitres": {
      "source": null,
      "transform": "none",
      "why": "only cubic metres are exported",
      "unsupportedReason": "would need volumeM3 multiplied by 1000"
    }
  },
  "confusablePairs": [
