  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "description": "Identifier of the trade account in the wholesaler's system."
      },
      "company_name": {
        "type": "string",
        "description": "Name of the trading company."
      },
      "first_name": {
        "type": "string",
        "description": "Given name of the contact person at the company."
      },
      "last_name": {
        "type": "string",
        "description": "Family name of the contact person at the company."
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Email address of the contact person."
      },
      "phone": {
        "type": "string",
        "description": "Phone number of the contact person."
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "blocked",
          "inactive"
        ],
        "description": "Whether the account may place orders."
      },
      "tier": {
        "type": "string",
        "enum": [
          "standard",
          "wholesale",
          "key_account"
        ],
        "description": "Group."
      },
      "customer_since": {
        "type": "string",
        "format": "date",
        "description": "Date the trade account was registered."
      },
      "credit_limit_net": {
        "type": "number",
        "description": "Credit limit granted to the account, excluding VAT."
      },
      "preferred_language": {
        "type": "string"
      }
    },
    "required": [
      "external_id",
      "company_name",
      "first_name",
      "last_name",
      "email",
      "status",
      "tier"
    ]
  },
  "groundTruth": {
    "external_id": {
      "source": "kh_id_kontrahenta",
      "transform": "copy",
      "why": "account id; kh_nip is the tax number and lp the export row"
    },
    "company_name": {
      "source": "kh_nazwa",
      "transform": "trim",
      "why": "company name, padded"
    },
    "first_name": {
      "source": "os_imie",
      "transform": "copy",
      "why": "contact given name; handlowiec is the sales rep"
    },
    "last_name": {
      "source": "os_nazwisko",
      "transform": "copy",
      "why": "contact family name"
    },
    "email": {
      "source": "os_email",
      "transform": "normalize_email",
      "why": "contact email, mixed case; kh_email_faktury is the invoicing mailbox"
    },
    "phone": {
      "source": "os_telefon",
      "transform": "copy",
      "why": "phone, null or missing for some"
    },
    "status": {
      "source": "status_kontrahenta",
      "transform": "map_enum",
      "categoryMap": {
        "Aktywny": "active",
        "Zablokowany – limit kredytowy": "blocked",
        "Nieaktywny": "inactive",
        "Do weryfikacji": null
      },
      "why": "account state; accounts to verify need review; status_platnosci is payment"
    },
    "tier": {
      "source": "grupa_rabatowa",
      "transform": "map_enum",
      "categoryMap": {
        "Detal": "standard",
        "Hurt A": "wholesale",
        "Hurt B": "wholesale",
        "Kluczowy": "key_account"
      },
      "why": "discount group; branza is the trade sector"
    },
    "customer_since": {
      "source": "data_rejestracji",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "registration date (Polish day-first); data_ostatniej_faktury is the last invoice"
    },
    "credit_limit_net": {
      "source": "limit_kredytowy_netto",
      "transform": "copy",
      "why": "net credit limit; limit_kredytowy_brutto includes VAT"
    },
    "preferred_language": {
      "source": null,
      "transform": "none",
      "why": "no language is exported"
    }
  },
