  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Stable identifier of the requester's account in the source system."
      },
      "displayName": {
        "type": "string",
        "description": "Name shown on tickets: given name followed by family name."
      },
      "primaryEmail": {
        "type": "string",
        "format": "email",
        "description": "Work email the requester uses to contact the agency."
      },
      "secondaryEmail": {
        "type": "string",
        "format": "email",
        "description": "Alternative personal address of the requester, used only if the work address bounces."
      },
      "phone": {
        "type": "string",
        "description": "Mobile number of the requester for urgent travel changes."
      },
      "company": {
        "type": "string",
        "description": "Client company the requester travels for."
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "suspended",
          "closed"
        ],
        "description": "Account state of the client company."
      },
      "supportPlan": {
        "type": "string",
        "enum": [
          "standard",
          "extended",
          "round_the_clock"
        ],
        "description": "Assistance package the client has bought, which sets opening hours."
      },
      "language": {
        "type": "string",
        "enum": [
          "fr",
          "en",
          "de"
        ],
        "description": "Language."
      },
      "customerSince": {
        "type": "string",
        "format": "date",
        "description": "Date the client account was opened."
      },
      "travelPolicy": {
        "type": "string",
        "description": "Travel policy that applies to the requester's bookings."
      }
    },
    "required": [
      "id",
      "displayName",
      "primaryEmail",
      "status",
      "supportPlan"
    ]
  },
  "groundTruth": {
    "id": {
      "source": "num_client",
      "transform": "copy",
      "why": "client number; id_fiche is the CRM record key and ligne the export row"
    },
    "displayName": {
      "source": null,
      "sources": [
        "contact.prenom",
        "contact.nom"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "client contact names; assistante.nom is the assistant who books and conseiller the agency's consultant"
    },
    "primaryEmail": {
      "source": "contact.coordonnees.email",
      "transform": "normalize_email",
      "why": "work email, mixed case and padded; assistante.email belongs to the assistant"
    },
    "secondaryEmail": {
      "source": "contact.coordonnees.email_secondaire",
      "transform": "normalize_email",
      "why": "personal address, null or missing for some"
    },
    "phone": {
      "source": "contact.coordonnees.portable",
      "transform": "copy",
      "why": "mobile, null or missing for some"
    },
    "company": {
      "source": "societe.raison_sociale",
      "transform": "trim",
      "why": "company name, padded"
    },
    "status": {
      "source": "statut_compte",
      "transform": "map_enum",
      "categoryMap": {
        "Actif": "active",
        "Actif - grand compte": "active",
        "Suspendu (impayé)": "suspended",
        "Résilié": "closed",
        "Prospect": null
      },
      "why": "account state; prospects need review; statut_paiement is payment"
    },
    "supportPlan": {
      "source": "formule",
      "transform": "map_enum",
      "categoryMap": {
        "Essentiel": "standard",
        "Confort": "extended",
        "Premium 24/7": "round_the_clock"
      },
      "why": "assistance package"
    },
    "language": {
      "source": "langue",
      "transform": "map_enum",
      "categoryMap": {
        "FR": "fr",
        "EN": "en",
        "DE": "de"
      },
      "why": "language, null or missing for some"
    },
    "customerSince": {
      "source": "date_ouverture",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "account opening (French day-first); date_dernier_voyage is the last trip"
    },
    "travelPolicy": {
      "source": null,
      "transform": "none",
      "why": "no travel policy is exported"
    }
  },
