  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "description": "Identifier of the customer account in your own system, used to match future imports."
      },
      "name": {
        "type": "string",
        "description": "Full name of the requester, given name first."
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Address the requester writes from; ticket replies go here."
      },
      "phone": {
        "type": "string",
        "description": "Mobile number used for urgent callbacks about a breakdown."
      },
      "organization": {
        "type": "object",
        "description": "Company the requester belongs to.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the business the requester works for."
          },
          "tier": {
            "type": "string",
            "enum": [
              "basic",
              "standard",
              "priority"
            ],
            "description": "Maintenance plan the business pays for, which sets response targets."
          }
        },
        "required": [
          "name"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "paused",
          "closed"
        ],
        "description": "Status."
      },
      "customer_since": {
        "type": "string",
        "format": "date",
        "description": "Date the customer's first service contract started."
      },
      "timezone": {
        "type": "string"
      },
      "lifetime_months": {
        "type": "integer",
        "description": "Number of whole months the account has been a customer."
      }
    },
    "required": [
      "external_id",
      "name",
      "email",
      "organization",
      "status"
    ]
  },
  "groundTruth": {
    "external_id": {
      "source": "account_no",
      "transform": "copy",
      "why": "account number; crm_record_id is the CRM's internal key and row_num the export row"
    },
    "name": {
      "source": null,
      "sources": [
        "primary_contact.first_name",
        "primary_contact.last_name"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "primary contact given and family name; account_manager is the contractor's own rep"
    },
    "email": {
      "source": "primary_contact.email",
      "transform": "normalize_email",
      "why": "primary contact email, mixed case and padded; billing_contact.email is accounts payable"
    },
    "phone": {
      "source": "primary_contact.mobile",
      "transform": "copy",
      "why": "contact mobile, null or missing for some"
    },
    "organization.name": {
      "source": "account.name",
      "transform": "trim",
      "why": "business name, padded in some rows"
    },
    "organization.tier": {
      "source": "account.c_service_tier",
      "transform": "map_enum",
      "categoryMap": {
        "Bronze PM": "basic",
        "Time & Materials": "basic",
        "Silver PM": "standard",
        "Gold PM": "priority"
      },
      "why": "maintenance plan; c_segment is the market segment"
    },
    "status": {
      "source": "c_account_status",
      "transform": "map_enum",
      "categoryMap": {
        "Active": "active",
        "Seasonal Hold": "paused",
        "Closed - Lost": "closed",
        "Do Not Service": "closed",
        "Duplicate": null
      },
      "why": "account lifecycle; duplicates need review; c_payment_status is receivables"
    },
    "customer_since": {
      "source": "contract_start",
      "transform": "parse_date",
      "dateFormat": "MM/DD/YYYY",
      "why": "first contract start (US month-first); contract_renewal is the next renewal and created_at the lead creation"
    },
    "timezone": {
      "source": null,
      "transform": "none",
      "why": "no time zone is exported; the city alone is not a supported transformation"
    },
    "lifetime_months": {
      "source": null,
      "transform": "none",
      "why": "not exported",
      "unsupportedReason": "would need the difference in months between contract_start and the import date"
    }
  },
