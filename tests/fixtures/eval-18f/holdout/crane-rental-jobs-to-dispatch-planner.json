  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "job_number": {
        "type": "string",
        "description": "Order number of the crane job."
      },
      "customer": {
        "type": "string",
        "description": "Company that hires the crane."
      },
      "customer_email": {
        "type": "string",
        "format": "email",
        "description": "Email address of the customer's contact for this job."
      },
      "crane_class": {
        "type": "string",
        "enum": [
          "mobile_50",
          "mobile_100",
          "tower",
          "telehandler"
        ],
        "description": "Type of crane the job needs."
      },
      "status": {
        "type": "string",
        "enum": [
          "confirmed",
          "tentative",
          "cancelled",
          "completed"
        ],
        "description": "Status."
      },
      "work_date": {
        "type": "string",
        "format": "date",
        "description": "Day the crane works on site."
      },
      "start_time": {
        "type": "string",
        "description": "Time the crane must be ready on site."
      },
      "booked_hours": {
        "type": "number",
        "description": "Number of hours the crane is booked for."
      },
      "site_postcode": {
        "type": "string",
        "description": "Postcode of the work site."
      },
      "hourly_rate": {
        "type": "number",
        "description": "Hourly rate charged for the crane, excluding VAT."
      },
      "job_value": {
        "type": "number",
        "description": "Expected value of the job excluding VAT."
      },
      "operator_licence": {
        "type": "string",
        "description": "Licence."
      }
    },
    "required": [
      "job_number",
      "customer",
      "crane_class",
      "status",
      "work_date",
      "start_time"
    ]
  },
  "groundTruth": {
    "job_number": {
      "source": "OrderNr",
      "transform": "copy",
      "why": "order number; OfferteNr is the quote and Regel the row"
    },
    "customer": {
      "source": "Klant",
      "transform": "trim",
      "why": "customer, padded; KlantContactpersoon is a person and Kraanmachinist the operator"
    },
    "customer_email": {
      "source": "KlantEmail",
      "transform": "normalize_email",
      "why": "customer contact email, mixed case"
    },
    "crane_class": {
      "source": "Kraantype",
      "transform": "map_enum",
      "categoryMap": {
        "Mobiele kraan 50t": "mobile_50",
        "Mobiele kraan 100t": "mobile_100",
        "Torenkraan": "tower",
        "Verreiker": "telehandler"
      },
      "why": "crane type"
    },
    "status": {
      "source": "OrderStatus",
      "transform": "map_enum",
      "categoryMap": {
        "Bevestigd": "confirmed",
        "Optie": "tentative",
        "Geannuleerd": "cancelled",
        "Uitgevoerd": "completed",
        "Interne reservering": null
      },
      "why": "order state; internal reservations need review; FactuurStatus is invoicing"
    },
    "work_date": {
      "source": "Werkdatum",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "work day (Dutch day-first); Aanvraagdatum is the request date"
    },
    "start_time": {
      "source": "Starttijd",
      "transform": "copy",
      "why": "start time"
    },
    "booked_hours": {
      "source": "Uren",
      "transform": "copy",
      "why": "booked hours, null in some"
    },
    "site_postcode": {
      "source": "Postcode",
      "transform": "copy",
      "why": "postcode, null or missing for some; Plaats is the town"
    },
    "hourly_rate": {
      "source": "TariefExclBtw",
      "transform": "copy",
      "why": "net rate; TariefInclBtw includes VAT"
    },
    "job_value": {
      "source": null,
      "transform": "none",
      "why": "not exported",
