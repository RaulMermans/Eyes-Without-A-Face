  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "requester_name": {
        "type": "string",
        "description": "Full name of the requester, given name first."
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Business email address of the requester."
      },
      "phone": {
        "type": "string",
        "description": "Mobile number of the requester."
      },
      "role": {
        "type": "string",
        "enum": [
          "primary",
          "technical",
          "billing"
        ],
        "description": "Role."
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "suspended",
          "cancelled"
        ],
        "description": "State of the customer's support contract."
      },
      "customer_since": {
        "type": "string",
        "format": "date",
        "description": "Date the support contract started."
      },
      "organization": {
        "type": "object",
        "description": "Organization the requester belongs to.",
        "properties": {
          "external_id": {
            "type": "string",
            "description": "Identifier of the customer organization in the provider's system."
          },
          "name": {
            "type": "string",
            "description": "Name of the customer organization."
          },
          "support_level": {
            "type": "string",
            "enum": [
              "bronze",
              "silver",
              "gold"
            ],
            "description": "Support level the organization has bought, which sets response hours."
          },
          "seats": {
            "type": "integer",
            "description": "Number of workplaces covered by the contract."
          }
        },
        "required": [
          "external_id",
          "name",
          "support_level"
        ]
      },
      "time_zone": {
        "type": "string"
      }
    },
    "required": [
      "requester_name",
      "email",
      "status",
      "organization"
    ]
  },
  "groundTruth": {
    "requester_name": {
      "source": null,
      "sources": [
        "Contact.FirstName",
        "Contact.Achternaam"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "contact names; AccountManager is the provider's own staff"
    },
    "email": {
      "source": "Contact.Email",
      "transform": "normalize_email",
      "why": "business email, mixed case and padded; EmailPrive is private"
    },
    "phone": {
      "source": "Contact.Mobiel",
      "transform": "copy",
      "why": "mobile, null or missing for some"
    },
    "role": {
      "source": "Contact.Rol",
      "transform": "map_enum",
      "categoryMap": {
        "Primary Contact": "primary",
        "Beslisser": "primary",
        "Technisch contact": "technical",
        "Billing contact": "billing"
      },
      "why": "contact role, null or missing for some"
    },
    "status": {
      "source": "ContractStatus",
      "transform": "map_enum",
      "categoryMap": {
        "Active": "active",
        "Actief": "active",
        "On hold - wanbetaling": "suspended",
        "Opgezegd": "cancelled",
        "Lead": null
      },
      "why": "contract state in two languages; leads need review; InvoiceStatus is billing"
    },
    "customer_since": {
      "source": "StartDatum",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "contract start (Dutch day-first); ContractEnd is the end"
    },
    "organization.external_id": {
      "source": "AccountID",
      "transform": "copy",
      "why": "account id; crm_guid is the CRM key and volgnr the export row"
    },
    "organization.name": {
      "source": "Company.Naam",
      "transform": "trim",
      "why": "company name, padded"
    },
    "organization.support_level": {
      "source": "SLA",
      "transform": "map_enum",
      "categoryMap": {
        "Bronze 8x5": "bronze",
        "Silver 12x5": "silver",
        "Gold 24x7": "gold"
      },
      "why": "SLA level"
    },
    "organization.seats": {
      "source": "Seats",
      "transform": "copy",
      "why": "seat count"
    },
    "time_zone": {
      "source": null,
      "transform": "none",
      "why": "no time zone is exported"
    }
  },
