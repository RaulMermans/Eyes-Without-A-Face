  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "description": "Identifier of the customer at the maintenance company."
      },
      "name": {
        "type": "string",
        "description": "Full name of the person who reports issues for the customer."
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Email address of that person."
      },
      "phone": {
        "type": "string",
        "description": "Mobile number for breakdown callbacks."
      },
      "organization": {
        "type": "string",
        "description": "Name of the residential community or building the customer represents."
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "on_hold",
          "terminated"
        ],
        "description": "Whether the maintenance contract is in force, on hold or terminated."
      },
      "custom_fields": {
        "type": "object",
        "description": "Account-specific fields.",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "basic",
              "full",
              "all_risk"
            ],
            "description": "Maintenance contract type, which sets what repairs are covered."
          },
          "lift_count": {
            "type": "integer",
            "description": "Number of lifts covered by the contract."
          },
          "contract_start": {
            "type": "string",
            "format": "date",
            "description": "Date."
          },
          "contract_years": {
            "type": "integer",
            "description": "Full years the customer has held a contract."
          }
        }
      },
      "time_zone": {
        "type": "string"
      }
    },
    "required": [
      "external_id",
      "name",
      "email",
      "status"
    ]
  },
  "groundTruth": {
    "external_id": {
      "source": "CodigoCliente",
      "transform": "copy",
      "why": "customer code; IdContrato is the contract and NumFila the export row"
    },
    "name": {
      "source": null,
      "sources": [
        "Presidente.Nombre",
        "Presidente.Apellidos"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "community president; Administrador.Nombre is the external property administrator"
    },
    "email": {
      "source": "Presidente.Email",
      "transform": "normalize_email",
      "why": "president email, mixed case and padded; Administrador.Email belongs to the administrator"
    },
    "phone": {
      "source": "Presidente.Movil",
      "transform": "copy",
      "why": "mobile, null or missing for some"
    },
    "organization": {
      "source": "Comunidad.Nombre",
      "transform": "trim",
      "why": "community name, padded"
    },
    "status": {
      "source": "EstadoContrato",
      "transform": "map_enum",
      "categoryMap": {
        "Vigente": "active",
        "Vigente - renovación pendiente": "active",
        "Suspendido": "on_hold",
        "Rescindido": "terminated",
        "Presupuesto enviado": null
      },
      "why": "contract state; a sent quote is not a customer and needs review; EstadoCobro is collection"
    },
    "custom_fields.plan": {
      "source": "TipoContrato",
      "transform": "map_enum",
      "categoryMap": {
        "Mantenimiento básico": "basic",
        "Mantenimiento integral": "full",
        "Todo riesgo": "all_risk"
      },
      "why": "contract type"
    },
    "custom_fields.lift_count": {
      "source": "NumAscensores",
      "transform": "copy",
      "why": "number of lifts"
    },
    "custom_fields.contract_start": {
      "source": "FechaInicio",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "contract start (Spanish day-first); FechaVencimiento is the expiry"
    },
    "custom_fields.contract_years": {
      "source": null,
      "transform": "none",
      "why": "not exported",
      "unsupportedReason": "would need the number of full years between FechaInicio and the import date"
    },
    "time_zone": {
      "source": null,
      "transform": "none",
      "why": "no time zone is exported"
    }
  },
  "confusablePairs": [
    {
      "kind": "customer-id-vs-transaction-id",
      "fields": [
        "CodigoCliente",
        "IdContrato"
      ],
      "correctFor": "external_id"
    },
    {
      "kind": "nested-entity-relationship",
      "fields": [
        "Presidente.Email",
        "Administrador.Email"
      ],
      "correctFor": "email"
    },
    {
      "kind": "nested-entity-relationship",
      "fields": [
        "Presidente.Nombre",
        "Administrador.Nombre"
      ],
      "correctFor": "name"
    },
    {
      "kind": "competing-category-fields",
      "fields": [
        "EstadoContrato",
        "EstadoCobro"
      ],
      "correctFor": "status"
    },
    {
      "kind": "modified-date-vs-created-date",
      "fields": [
        "FechaInicio",
        "FechaVencimiento"
      ],
      "correctFor": "custom_fields.contract_start"
    }
  ],
  "sourceConcepts": {
    "CodigoCliente": "customer-id",
    "IdContrato": "transaction-id",
    "NumFila": "other-identifier",
    "Comunidad.Nombre": "organization-name",
