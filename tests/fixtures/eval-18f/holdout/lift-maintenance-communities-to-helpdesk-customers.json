    "Administrador.Nombre": "person-name",
    "Administrador.Email": "email",
    "EstadoContrato": "account-status",
    "EstadoCobro": "payment-status",
    "TipoContrato": "category",
    "FechaInicio": "start-date",
    "FechaVencimiento": "end-date",
    "NumAscensores": "quantity"
  },
  "destinationConcepts": {
    "external_id": "customer-id",
    "name": "person-name",
