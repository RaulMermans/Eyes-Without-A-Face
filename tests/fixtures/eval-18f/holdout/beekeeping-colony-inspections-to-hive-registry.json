  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "colony_id": {
        "type": "string",
        "description": "Identifier of the bee colony."
      },
      "apiary_code": {
        "type": "string",
        "description": "Code of the apiary site where the colony stands."
      },
      "keeper_name": {
        "type": "string",
        "description": "Full name of the beekeeper who owns the colony, given name first."
      },
      "keeper_email": {
        "type": "string",
        "format": "email",
        "description": "Email address of the beekeeper."
      },
      "breed": {
        "type": "string",
        "enum": [
          "carnica",
          "buckfast",
          "mellifera",
          "mixed"
        ],
        "description": "Honey bee breed of the colony."
      },
      "strength": {
        "type": "string",
        "enum": [
          "strong",
          "medium",
          "weak"
        ],
        "description": "Strength."
      },
      "treatment": {
        "type": "string",
        "enum": [
          "formic_acid",
          "oxalic_acid",
          "none"
        ],
        "description": "Mite treatment applied at the inspection."
      },
      "varroa_mites_per_day": {
        "type": "number",
        "description": "Natural mite drop counted per day."
      },
      "honey_net_kg": {
        "type": "number",
        "description": "Honey harvested from the colony in kilograms, without frames and containers."
      },
      "inspected_on": {
        "type": "string",
        "format": "date",
        "description": "Date the colony was inspected."
      },
      "queen_age_years": {
        "type": "integer",
        "description": "Age of the queen in years at the inspection."
      },
      "hive_weight_kg": {
        "type": "number"
      }
    },
    "required": [
      "colony_id",
      "apiary_code",
      "keeper_name",
      "breed",
      "strength",
      "inspected_on"
    ]
  },
  "groundTruth": {
    "colony_id": {
      "source": "volkNr",
      "transform": "copy",
      "why": "colony number; kontrollId is the inspection and zeile the row"
    },
    "apiary_code": {
      "source": "standNr",
      "transform": "trim",
      "why": "apiary site, padded in some rows"
    },
    "keeper_name": {
      "source": null,
      "sources": [
        "imker.vorname",
        "imker.nachname"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "owner; kontrolleur is the inspector"
    },
    "keeper_email": {
      "source": "imker.email",
      "transform": "normalize_email",
      "why": "keeper email, mixed case"
    },
    "breed": {
      "source": "bienenrasse",
      "transform": "map_enum",
      "categoryMap": {
        "Carnica": "carnica",
        "Buckfast": "buckfast",
        "Dunkle Biene": "mellifera",
        "Mischling": "mixed"
      },
      "why": "breed"
    },
    "strength": {
      "source": "volksstaerke",
      "transform": "map_enum",
      "categoryMap": {
        "stark": "strong",
        "mittel": "medium",
        "schwach": "weak",
        "weisellos": null
      },
      "why": "colony strength; queenless colonies need review; sanftmut is temper"
    },
    "treatment": {
      "source": "behandlung",
      "transform": "map_enum",
      "categoryMap": {
        "Ameisensäure": "formic_acid",
        "Oxalsäure": "oxalic_acid",
        "keine": "none"
      },
      "why": "treatment, null or missing for some"
    },
    "varroa_mites_per_day": {
      "source": "varroaBefall",
      "transform": "copy",
      "why": "mite drop, null or missing for some"
    },
    "honey_net_kg": {
      "source": "honigertrag.netto_kg",
      "transform": "copy",
      "why": "net honey; brutto_kg includes frames"
    },
    "inspected_on": {
      "source": "kontrolldatum",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "inspection date (German day-first); naechsteKontrolle is the next one"
    },
    "queen_age_years": {
      "source": null,
      "transform": "none",
      "why": "only the queen's year is exported",
      "unsupportedReason": "would need the inspection year minus koenigin.jahrgang"
    },
    "hive_weight_kg": {
      "source": null,
      "transform": "none",
      "why": "not exported"
    }
  },
