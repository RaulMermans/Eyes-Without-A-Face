  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "external_ref": {
        "type": "string",
        "description": "Reference of the client in the caterer's own records."
      },
      "name": {
        "type": "string",
        "description": "Full name of the client's contact person."
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Personal work email of the contact person."
      },
      "phone": {
        "type": "string",
        "description": "Phone number of the contact person."
      },
      "organization": {
        "type": "object",
        "description": "Client company.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Registered name of the client company."
          },
          "service": {
            "type": "string",
            "enum": [
              "canteen",
              "vouchers",
              "events"
            ],
            "description": "Catering service the client buys."
          }
        },
        "required": [
          "name"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "suspended",
          "churned"
        ],
        "description": "Status."
      },
      "customer_since": {
        "type": "string",
        "format": "date",
        "description": "Date the client's first service was activated."
      },
      "annual_value_eur": {
        "type": "number",
        "description": "Expected yearly revenue from the client in euros."
      }
    },
    "required": [
      "external_ref",
      "name",
      "email",
      "organization",
      "status"
    ]
  },
  "groundTruth": {
    "external_ref": {
      "source": "cf_codice_cliente",
      "transform": "copy",
      "why": "client code; partita_iva is the VAT number and id_riga the export row"
    },
    "name": {
      "source": null,
      "sources": [
        "referente_nome",
        "referente_cognome"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "contact person; commerciale is the caterer's sales rep"
    },
    "email": {
      "source": "referente_email",
      "transform": "normalize_email",
      "why": "contact email, mixed case; null in a few rows, which are held; email_pec is the company's certified mailbox"
    },
    "phone": {
      "source": "referente_tel",
      "transform": "copy",
      "why": "phone, null or missing for some"
    },
    "organization.name": {
      "source": "ragione_sociale",
      "transform": "trim",
      "why": "company name, padded"
    },
    "organization.service": {
      "source": "tipo_servizio",
      "transform": "map_enum",
      "categoryMap": {
        "Mensa aziendale": "canteen",
        "Buoni pasto": "vouchers",
        "Coffee break & eventi": "events"
      },
      "why": "service type"
    },
    "status": {
      "source": "stato_cliente",
      "transform": "map_enum",
      "categoryMap": {
        "Attivo": "active",
        "Prova gratuita": "active",
        "Sospeso": "suspended",
        "Cessato": "churned",
        "Da verificare": null
      },
      "why": "client state; rows to verify need review; stato_pagamenti is payment"
    },
    "customer_since": {
      "source": "data_attivazione",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "activation date (Italian day-first); data_ultimo_ordine is the last order"
    },
    "annual_value_eur": {
      "source": null,
      "transform": "none",
      "why": "not exported",
      "unsupportedReason": "would need covers per day multiplied by a price per cover and the number of working days"
    }
  },
