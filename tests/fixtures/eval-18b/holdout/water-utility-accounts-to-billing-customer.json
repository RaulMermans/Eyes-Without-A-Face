  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "customer_number": {
        "type": "string"
      },
      "full_name": {
        "type": "string"
      },
      "company": {
        "type": [
          "string",
          "null"
        ]
      },
      "contact_email": {
        "type": "string",
        "format": "email"
      },
      "billing_email": {
        "type": [
          "string",
          "null"
        ],
        "format": "email"
      },
      "contract_start": {
        "type": "string",
        "format": "date"
      },
