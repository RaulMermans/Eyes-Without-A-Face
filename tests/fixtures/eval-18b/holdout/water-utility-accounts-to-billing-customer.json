  "groundTruth": {
    "customer_number": {
      "source": "Kundennummer",
      "transform": "copy",
      "why": "customer number; invoice_no is a single bill and meter_id the meter"
    },
    "full_name": {
      "source": null,
      "sources": [
        "Vorname",
        "Nachname"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "account holder name is first name plus surname"
    },
    "company": {
      "source": "Firma",
      "transform": "trim",
      "why": "business name for commercial accounts, padded"
    },
    "contact_email": {
      "source": "email_primary",
      "transform": "normalize_email",
      "why": "main contact email, mixed case"
    },
    "billing_email": {
      "source": "Email_Rechnung",
      "transform": "copy",
      "why": "separate e-invoice address when given"
    },
    "contract_start": {
      "source": "Vertragsbeginn",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "supply contract start (German day-first); last_reading_date is the last meter reading"
    },
    "tariff": {
      "source": "Tarif",
      "transform": "map_enum",
      "categoryMap": {
        "Haushalt Standard": "residential",
        "Haushalt Öko": "residential",
        "Gewerbe": "business",
        "Landwirtschaft": "agricultural",
        "Leerstand": null
      },
      "why": "tariff group; Leerstand marks a vacant property with no paying customer"
