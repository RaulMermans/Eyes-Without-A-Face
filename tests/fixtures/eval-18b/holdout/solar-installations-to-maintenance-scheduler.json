  "groundTruth": {
    "asset_id": {
      "source": "AnlagenNr",
      "transform": "copy",
      "why": "installation number identifies the PV system; AuftragsNr is the original sales order"
    },
    "customer_ref": {
      "source": "KundenNr",
      "transform": "copy",
      "why": "customer number of the operator"
    },
    "owner_name": {
      "source": "Betreiber.Name",
      "transform": "trim",
      "why": "the operator owns the system; Installateur.Firma is the installer company"
    },
    "owner_email": {
      "source": "Betreiber.Email",
      "transform": "normalize_email",
      "why": "operator email, mixed case; Installateur.Email is the installer's service desk"
    },
    "commissioned_on": {
      "source": "Inbetriebnahme",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "commissioning date (German day-first); Erfasst is when the record was entered"
    },
    "last_service": {
      "source": "LetzteWartung",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "date of the last maintenance visit, empty if never serviced"
    },
    "capacity_kwp": {
      "source": "Leistung_kWp",
      "transform": "copy",
      "why": "peak capacity in kWp"
    },
    "mount_type": {
      "source": "Anlagentyp",
      "transform": "map_enum",
      "categoryMap": {
        "Aufdach": "roof",
        "Freifläche": "ground",
        "Fassade": "facade",
        "Carport": "carport",
        "Balkonkraftwerk": null
      },
      "why": "mounting type; a Balkonkraftwerk is a plug-in balcony unit outside the service scope"
    },
    "service_plan": {
      "source": "Wartungsvertrag",
      "transform": "map_enum",
      "categoryMap": {
        "Basis": "basic",
        "Komfort": "standard",
        "Premium": "premium",
        "keiner": "none",
        "Kulanz (ohne Vertrag)": null
      },
      "why": "maintenance contract tier; Kulanz goodwill visits have no contract tier and need review"
    },
    "site.postal_code": {
      "source": "Standort.PLZ",
      "transform": "copy",
      "why": "postal code of the installation site"
    },
    "site.city": {
      "source": "Standort.Ort",
      "transform": "copy",
      "why": "town of the installation site"
    },
    "warranty_expires": {
      "source": null,
      "transform": "none",
      "why": "no warranty end date is exported"
    }
  },
  "confusablePairs": [
    {
      "kind": "customer-id-vs-transaction-id",
      "fields": [
        "KundenNr",
        "AuftragsNr"
      ],
      "correctFor": "customer_ref"
    },
    {
      "kind": "two-email-fields",
      "fields": [
        "Betreiber.Email",
        "Installateur.Email"
      ],
      "correctFor": "owner_email"
    },
    {
      "kind": "organization-name-vs-person-name",
      "fields": [
        "Betreiber.Name",
        "Installateur.Firma"
      ],
      "correctFor": "owner_name"
    },
    {
      "kind": "modified-date-vs-created-date",
      "fields": [
        "Inbetriebnahme",
        "Erfasst"
      ],
      "correctFor": "commissioned_on"
    }
  ],
