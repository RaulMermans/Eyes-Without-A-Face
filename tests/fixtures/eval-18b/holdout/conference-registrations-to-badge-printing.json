        ]
      },
      "badge_type": {
        "type": "string",
        "enum": [
          "attendee",
          "vip",
          "speaker",
          "press",
          "exhibitor"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "confirmed",
          "cancelled",
          "waitlisted"
        ]
      },
