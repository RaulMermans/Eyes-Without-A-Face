  "groundTruth": {
    "registration_id": {
      "source": "reg_id",
      "transform": "copy",
      "why": "one registration per attendee; order_no can cover several attendees"
    },
    "badge_name": {
      "source": null,
      "sources": [
        "att_first",
        "att_last"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "badge shows the attendee first and last name, not the buyer"
    },
    "email": {
      "source": "att_email",
      "transform": "normalize_email",
      "why": "attendee email, mixed case; buyer_email is whoever paid"
    },
    "organization": {
      "source": "company",
      "transform": "trim",
      "why": "attendee company, padded in some rows"
    },
    "job_title": {
      "source": "job_ttl",
      "transform": "copy",
      "why": "attendee job title"
    },
    "badge_type": {
      "source": "tkt_type",
      "transform": "map_enum",
      "categoryMap": {
        "Early Bird": "attendee",
        "Standard": "attendee",
        "VIP All Access": "vip",
        "Speaker Comp": "speaker",
        "Press": "press",
        "Exhibitor Staff": "exhibitor",
        "Day Pass (Thu)": "attendee",
        "TEST - do not print": null
      },
      "why": "ticket type decides the badge colour; the TEST ticket must never be printed"
    },
    "status": {
      "source": "reg_status",
      "transform": "map_enum",
      "categoryMap": {
        "CONF": "confirmed",
        "CXL": "cancelled",
        "WL": "waitlisted",
        "PEND": null
      },
      "why": "registration state codes; PEND awaits confirmation; pay_status is payment"
    },
    "registered_on": {
      "source": "reg_dt",
      "transform": "parse_date",
      "dateFormat": "MM/DD/YYYY",
      "why": "registration date (US month-first); upd_ts is a modification stamp"
    },
    "country": {
      "source": "addr.ctry",
      "transform": "copy",
      "why": "attendee country code"
    },
    "track": {
      "source": null,
      "transform": "none",
      "why": "the export holds no track selection; diet and ticket type are not tracks"
    }
  },
