      "holder_name",
      "email",
      "plan",
      "badge_state",
      "valid_from"
    ]
  },
  "groundTruth": {
    "badge_holder_id": {
      "source": "num_adherent",
      "transform": "copy",
      "why": "member number; num_facture is an invoice"
    },
    "holder_name": {
      "source": null,
      "sources": [
        "prenom",
        "nom"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "name printed on the badge is first name plus surname"
    },
    "email": {
      "source": "courriel",
      "transform": "normalize_email",
      "why": "member's own address; courriel_facturation is the billing mailbox"
    },
    "phone": {
      "source": "tel_portable",
      "transform": "copy",
      "why": "member mobile; tel_standard is the company switchboard"
    },
    "company": {
      "source": "raison_sociale",
      "transform": "trim",
      "why": "employer, empty for freelancers, padded in some rows"
    },
    "plan": {
      "source": "formule",
      "transform": "map_enum",
      "categoryMap": {
        "Nomade": "hot_desk",
        "Bureau fixe": "dedicated_desk",
        "Bureau privatif": "private_office",
        "Accès week-end": "hot_desk",
        "Domiciliation": null,
        "Invité test": null
      },
      "why": "membership formula to desk type; Domiciliation is a mail-address service with no physical access and Invité test is a test account"
    },
    "badge_state": {
      "source": "statut_contrat",
      "transform": "map_enum",
      "categoryMap": {
        "en cours": "enabled",
        "suspendu": "disabled",
        "résilié": "disabled",
        "en attente de paiement": null
      },
      "why": "contract state decides the badge; awaiting first payment needs a human decision"
    },
    "valid_from": {
      "source": "date_debut",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "contract start (French day-first); date_creation is when the CRM row was made"
    },
    "valid_to": {
      "source": "date_fin",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "contract end, empty when open-ended"
    },
    "site_code": {
      "source": "espace.site.code",
      "transform": "copy",
      "why": "site code of the member's space"
    },
    "floor": {
      "source": "espace.etage",
      "transform": "copy",
      "why": "floor number of the assigned space"
    },
    "vehicle_plate": {
      "source": null,
      "transform": "none",
      "why": "no parking or vehicle data is exported"
    }
  },
