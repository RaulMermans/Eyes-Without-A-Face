  "groundTruth": {
    "student_number": {
      "source": "numeroMatricula",
      "transform": "copy",
      "why": "matriculation number; codigoInscricao identifies one enrolment event"
    },
    "full_name": {
      "source": null,
      "sources": [
        "primeiroNome",
        "apelido"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "full name is first name plus surname"
    },
    "institutional_email": {
      "source": "emailInstitucional",
      "transform": "normalize_email",
      "why": "university mailbox, mixed case; emailPessoal is private"
    },
    "birth_date": {
      "source": "dataNascimento",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "date of birth (Portuguese day-first)"
    },
    "enrolled_on": {
      "source": "dataInscricao",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "enrolment date (Portuguese day-first); dataAtualizacao is a modification stamp"
    },
    "program_code": {
      "source": "curso.codigo",
      "transform": "copy",
      "why": "programme code, not the programme title"
    },
    "study_mode": {
      "source": "regime",
      "transform": "map_enum",
      "categoryMap": {
        "Tempo integral": "full_time",
        "Tempo parcial": "part_time",
        "Trabalhador-estudante": "part_time",
        "Erasmus (entrada)": "exchange"
      },
      "why": "study regime; working students study part time; incoming Erasmus is exchange"
    },
    "status": {
      "source": "situacao",
      "transform": "map_enum",
      "categoryMap": {
        "Inscrito": "enrolled",
        "Suspenso": "suspended",
        "Anulado": "withdrawn",
        "Concluído": "graduated",
        "Pré-inscrição": null
      },
      "why": "academic state; pre-registration is not yet an enrolment"
    },
    "year_of_study": {
      "source": "anoCurricular",
      "transform": "copy",
      "why": "curricular year"
    },
    "nationality": {
      "source": "nacionalidade",
      "transform": "copy",
      "why": "nationality country code"
    },
    "national_id": {
      "source": null,
      "transform": "none",
      "why": "no citizen card or tax number is exported"
    }
  },
