  "groundTruth": {
    "member_id": {
      "source": "idSocio",
      "transform": "copy",
      "why": "member number; idPago is a payment reference"
    },
    "holder_name": {
      "source": "nombreCompleto",
      "transform": "trim",
      "why": "full member name with stray whitespace in some rows"
    },
    "email": {
      "source": "correo",
      "transform": "normalize_email",
      "why": "member's own email; correoEmpresa is the employer HR contact for corporate plans"
    },
    "mobile": {
      "source": "telefonoMovil",
      "transform": "copy",
      "why": "mobile number; telefonoFijo is a landline"
    },
    "badge_uid": {
      "source": "tarjeta.uid",
      "transform": "copy",
      "why": "NFC card UID that the door readers check"
    },
    "access_level": {
      "source": "plan",
      "transform": "map_enum",
      "categoryMap": {
        "Básico": "standard",
        "Premium": "full",
        "Nocturno": "off_peak",
        "Familiar": "full",
        "Corporativo": "standard",
        "Prueba 7 días": "standard",
        "INTERNO-QA": null
      },
      "why": "plan name decides door access hours; INTERNO-QA is a staff test account"
    },
    "status": {
      "source": "estadoSocio",
      "transform": "map_enum",
      "categoryMap": {
        "activo": "active",
        "congelado": "suspended",
        "moroso": "suspended",
        "baja": "terminated",
        "pendiente alta": null
      },
      "why": "membership state; pendiente alta has not been activated yet"
    },
    "valid_from": {
      "source": "fechaAlta",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "membership start date; fechaUltimoAcceso is the last door scan"
    },
    "valid_until": {
      "source": "fechaBaja",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "cancellation date, empty for running memberships"
    },
    "home_site": {
      "source": "sede.codigo",
      "transform": "copy",
      "why": "site code of the home club, not the city"
    },
    "photo_url": {
      "source": null,
      "transform": "none",
      "why": "no member photo is exported"
    }
  },
