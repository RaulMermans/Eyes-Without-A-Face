  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "email": {
        "type": "string",
        "format": "email"
      },
      "phone": {
        "type": [
          "string",
          "null"
        ]
      },
      "organization": {
        "type": [
          "string",
          "null"
        ]
      },
      "created_at": {
        "type": "string",
        "format": "date"
      },
      "requester_type": {
        "type": "string",
        "enum": [
          "prospect",
          "customer",
          "former_customer"
        ]
      },
      "locale": {
        "type": "string",
        "enum": [
          "en",
          "de",
          "fr",
          "nl",
          "es"
        ]
      },
      "address": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        },
        "required": []
      },
      "time_zone": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "external_id",
      "name",
      "email",
      "requester_type"
    ]
  },
  "groundTruth": {
    "external_id": {
      "source": "c_ContactId",
      "transform": "copy",
      "why": "the CRM contact id identifies the person; c_OpportunityId is a sales deal"
    },
    "name": {
      "source": null,
      "sources": [
        "c_FirstName",
        "c_LastName"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "requester display name is given name plus family name; c_ContactOwner is the sales rep"
    },
    "email": {
      "source": "c_Email",
      "transform": "normalize_email",
      "why": "the contact's own address (mixed case in the export); c_AssistantEmail belongs to an assistant"
    },
    "phone": {
      "source": "c_Phone",
      "transform": "copy",
      "why": "main business phone of the contact; mobile is a separate optional number"
    },
    "organization": {
      "source": "c_AccountName",
      "transform": "trim",
      "why": "the account the contact works for; some values carry padding whitespace"
    },
    "created_at": {
      "source": "c_CreatedOn",
      "transform": "parse_date",
      "dateFormat": "MM/DD/YYYY",
      "why": "when the contact was created; c_LastActivity is last touched"
    },
    "requester_type": {
      "source": "c_LifecycleStage",
      "transform": "map_enum",
      "categoryMap": {
        "Subscriber": "prospect",
        "Lead": "prospect",
        "Marketing Qualified Lead": "prospect",
        "Sales Qualified Lead": "prospect",
        "Customer": "customer",
        "Evangelist": "customer",
        "Former Customer": "former_customer",
        "TEST RECORD": null
      },
      "why": "lifecycle stage expresses the commercial relationship; TEST RECORD rows are not real requesters"
    },
    "locale": {
      "source": "c_PreferredLang",
      "transform": "map_enum",
      "categoryMap": {
        "English": "en",
        "Deutsch": "de",
        "Français": "fr",
        "Nederlands": "nl",
        "Español": "es",
        "--None--": null
      },
      "why": "preferred language label to ISO code; --None-- means not chosen"
    },
    "address.city": {
      "source": "c_MailingAddress.City",
      "transform": "copy",
      "why": "city of the mailing address"
    },
    "address.country": {
      "source": "c_MailingAddress.Country",
      "transform": "copy",
      "why": "ISO country code of the mailing address"
    },
    "time_zone": {
      "source": null,
      "transform": "none",
      "why": "the CRM export carries no time zone; country alone does not determine it"
    }
  },
  "confusablePairs": [
    {
      "kind": "customer-id-vs-transaction-id",
      "fields": [
        "c_ContactId",
        "c_OpportunityId"
      ],
      "correctFor": "external_id"
    },
    {
      "kind": "two-email-fields",
      "fields": [
