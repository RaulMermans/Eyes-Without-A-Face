      ],
      "correctFor": "email"
    },
    {
      "kind": "modified-date-vs-created-date",
      "fields": [
        "c_CreatedOn",
        "c_LastActivity"
      ],
      "correctFor": "created_at"
    },
    {
      "kind": "phone-or-code-confusion",
      "fields": [
        "c_Phone",
        "c_MobilePhone"
      ],
      "correctFor": "phone"
    },
    {
      "kind": "organization-name-vs-person-name",
      "fields": [
        "c_AccountName",
        "c_ContactOwner"
      ],
      "correctFor": "organization"
    }
  ],
