    ]
  },
  "groundTruth": {
    "order_id": {
      "source": "num_commande",
      "transform": "copy",
      "why": "order number; id_ligne is an export row counter and code_client identifies the buyer"
    },
    "customer_code": {
      "source": "client.code_client",
      "transform": "copy",
      "why": "buyer account code"
    },
    "buyer_company": {
      "source": "client.raison_sociale",
      "transform": "trim",
      "why": "company name, padded in some rows"
    },
    "contact_name": {
      "source": null,
      "sources": [
        "client.contact.prenom",
        "client.contact.nom"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "buyer contact first and last name; commercial is the estate sales rep"
    },
    "contact_email": {
      "source": "client.contact.courriel",
      "transform": "normalize_email",
      "why": "buyer contact email, mixed case in the export"
    },
    "ordered_on": {
      "source": "date_commande",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "order date (French day-first)"
    },
    "requested_delivery_on": {
      "source": "date_livraison_souhaitee",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "requested delivery date, absent for some orders"
    },
    "order_status": {
      "source": "statut_commande",
      "transform": "map_enum",
      "categoryMap": {
        "En préparation": "in_preparation",
        "Expédiée": "shipped",
        "Livrée": "delivered",
        "Annulée": "cancelled",
        "Brouillon interne": null
      },
      "why": "fulfilment state; internal drafts are not real orders and need review"
    },
    "payment_status": {
      "source": "statut_reglement",
      "transform": "map_enum",
      "categoryMap": {
        "Payé": "paid",
        "En attente de règlement": "pending",
        "Relance 1": "overdue",
        "Litige": "disputed",
        "Avoir émis": "credited"
      },
      "why": "payment state; a first reminder means the invoice is overdue, a credit note means credited"
    },
    "cases_ordered": {
      "source": "nb_caisses",
      "transform": "copy",
      "why": "number of cases"
    },
    "amount_incl_vat": {
      "source": null,
      "transform": "none",
      "why": "only the net amount (montant_ht) is exported",
      "unsupportedReason": "the VAT-inclusive amount would have to be computed from the net amount and a VAT rate"
    }
  },
