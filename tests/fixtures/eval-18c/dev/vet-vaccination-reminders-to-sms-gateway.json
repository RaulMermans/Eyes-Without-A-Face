  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "patient_id": {
        "type": "string",
        "description": "Identifier of the animal patient at the practice."
      },
      "pet_name": {
        "type": "string",
        "description": "Name of the animal, used in the SMS text."
      },
      "species": {
        "type": "string",
        "enum": [
          "dog",
          "cat",
          "rabbit",
          "ferret",
          "guinea_pig"
        ],
        "description": "Species of the animal."
      },
      "vaccine": {
        "type": "string",
        "enum": [
          "distemper_combo",
          "feline_panleukopenia",
          "rabies",
          "kennel_cough",
          "myxomatosis_rhd",
          "leptospirosis"
        ],
        "description": "Vaccine that is due."
      },
      "due_on": {
        "type": "string",
        "format": "date",
        "description": "Date by which the vaccination must be given."
      },
      "owner_name": {
        "type": "string",
        "description": "Full name of the owner."
      },
      "owner_mobile": {
        "type": "string",
        "description": "Mobile phone number of the owner, in international format; the SMS is sent here."
      },
      "owner_email": {
        "type": "string",
        "format": "email",
        "description": "Email address of the owner, fallback channel."
      },
      "reminder_stage": {
        "type": "string",
        "enum": [
          "scheduled",
          "reminded",
          "administered",
          "postponed"
        ],
        "description": "Where the vaccination reminder stands."
      },
      "preferred_language": {
        "type": "string",
        "enum": [
          "nl",
          "en",
          "de"
        ],
        "description": "Language for the SMS text."
      }
    },
    "required": [
      "patient_id",
      "pet_name",
      "species",
      "vaccine",
      "due_on",
      "owner_name",
      "owner_mobile"
    ]
  },
  "groundTruth": {
    "patient_id": {
      "source": "patientnummer",
      "transform": "copy",
      "why": "patient number; dossier_regel is a record line"
    },
    "pet_name": {
      "source": "dier.naam",
      "transform": "copy",
      "why": "animal name"
    },
    "species": {
      "source": "dier.soort",
      "transform": "map_enum",
      "categoryMap": {
        "Hond": "dog",
        "Kat": "cat",
        "Konijn": "rabbit",
        "Fret": "ferret",
        "Cavia": "guinea_pig"
      },
      "why": "species translated"
    },
    "vaccine": {
      "source": "vaccinatie.type",
      "transform": "map_enum",
      "categoryMap": {
        "Cocktail (DHP)": "distemper_combo",
        "Kattenziekte": "feline_panleukopenia",
        "Rabiës": "rabies",
        "Kennelhoest": "kennel_cough",
        "Myxomatose/RHD": "myxomatosis_rhd",
        "Leptospirose": "leptospirosis"
      },
      "why": "vaccine names translated"
    },
    "due_on": {
      "source": "vaccinatie.vervaldatum",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "due date (Dutch day-first); laatste_datum is the previous shot"
    },
    "owner_name": {
      "source": "eigenaar.naam",
      "transform": "trim",
      "why": "owner name, padded; dierenarts is the vet"
    },
    "owner_mobile": {
      "source": null,
      "transform": "none",
      "why": "the export contains no owner phone number; praktijk.telefoon is the practice switchboard"
    },
    "owner_email": {
      "source": "eigenaar.email",
      "transform": "normalize_email",
      "why": "owner email, mixed case, sometimes absent"
    },
    "reminder_stage": {
      "source": "vaccinatie.status",
      "transform": "map_enum",
      "categoryMap": {
