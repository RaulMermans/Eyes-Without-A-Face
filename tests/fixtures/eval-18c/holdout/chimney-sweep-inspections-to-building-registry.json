  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "inspection_id": {
        "type": "string",
        "description": "Order number of the inspection visit."
      },
      "property_id": {
        "type": "string",
        "description": "Registry identifier of the inspected property."
      },
      "owner_name": {
        "type": "string",
        "description": "Name of the property owner."
      },
      "owner_email": {
        "type": "string",
        "format": "email",
        "description": "Email of the property owner."
      },
      "heating_type": {
        "type": "string",
        "enum": [
          "gas_condensing",
          "oil_boiler",
          "wood_stove",
          "pellet_boiler",
          "open_fireplace"
        ],
        "description": "Kind of heating appliance inspected."
      },
      "result": {
        "type": "string",
        "enum": [
          "passed",
          "minor_defects",
          "major_defects",
          "shutdown_ordered"
        ],
        "description": "Outcome of the inspection."
      },
      "billing_status": {
        "type": "string",
        "enum": [
          "paid",
          "open",
          "voided"
        ],
        "description": "State of the inspection invoice."
      },
      "inspected_on": {
        "type": "string",
        "format": "date",
        "description": "Date of the inspection."
      },
      "next_due": {
        "type": "string",
        "format": "date",
        "description": "Date the next inspection is due."
      },
      "co_ppm": {
        "type": "integer",
        "description": "Measured carbon monoxide concentration in ppm."
      },
      "emission_class": {
        "type": "string",
        "description": "Emission class of the appliance under the federal ordinance."
      }
    },
    "required": [
      "inspection_id",
      "property_id",
      "owner_name",
      "heating_type",
      "result",
      "inspected_on"
    ]
  },
  "groundTruth": {
    "inspection_id": {
      "source": "Pruefung.Auftragsnr",
      "transform": "copy",
      "why": "inspection order number; Kehrbuch_Nr is the property's sweep log entry"
    },
    "property_id": {
      "source": "Objekt.Liegenschafts_ID",
      "transform": "copy",
      "why": "property id"
    },
    "owner_name": {
      "source": "Eigentuemer.Name",
      "transform": "trim",
      "why": "owner name, padded; Bezirksschornsteinfeger is the inspector"
    },
    "owner_email": {
      "source": "Eigentuemer.EMail",
      "transform": "normalize_email",
      "why": "owner email, mixed case, sometimes absent"
    },
    "heating_type": {
      "source": "Feuerstaette.Art",
      "transform": "map_enum",
      "categoryMap": {
        "Gas-Brennwerttherme": "gas_condensing",
        "Öl-Heizkessel": "oil_boiler",
        "Kaminofen (Holz)": "wood_stove",
        "Pelletkessel": "pellet_boiler",
        "Offener Kamin": "open_fireplace"
      },
      "why": "appliance kind; Brennstoff is the fuel"
    },
    "result": {
      "source": "Pruefung.Ergebnis",
      "transform": "map_enum",
      "categoryMap": {
        "ohne Mängel": "passed",
        "geringe Mängel": "minor_defects",
        "erhebliche Mängel – Nachprüfung": "major_defects",
        "Stilllegung angeordnet": "shutdown_ordered",
        "Probelauf (nicht werten)": null
      },
      "why": "inspection result; trial runs are not to be counted and need review"
    },
    "billing_status": {
      "source": "Rechnungsstatus",
      "transform": "map_enum",
      "categoryMap": {
        "bezahlt": "paid",
        "offen": "open",
        "storniert": "voided"
      },
      "why": "invoice state"
    },
    "inspected_on": {
      "source": "Pruefung.Datum",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "inspection date (German day-first)"
    },
    "next_due": {
      "source": "Feuerstaette.naechste_Faelligkeit",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "next due date, sometimes absent"
    },
    "co_ppm": {
      "source": "Messung.CO_ppm",
      "transform": "copy",
      "why": "CO measurement"
    },
    "emission_class": {
      "source": null,
      "transform": "none",
      "why": "no emission class is exported"
    }
  },
