  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "rental_id": {
        "type": "string",
        "description": "Hire contract number."
      },
      "customer_name": {
        "type": "string",
        "description": "Business hiring the equipment."
      },
      "customer_email": {
        "type": "string",
        "format": "email",
        "description": "Email address for the certificate."
      },
      "equipment_category": {
        "type": "string",
        "enum": [
          "excavator",
          "aerial_platform",
          "compaction",
          "mixing",
          "access_scaffold"
        ],
        "description": "Insurance category of the hired equipment."
      },
      "damage_waiver": {
        "type": "string",
        "enum": [
          "full",
          "basic",
          "declined"
        ],
        "description": "Damage waiver taken by the hirer."
      },
      "rental_status": {
        "type": "string",
        "enum": [
          "on_hire",
          "returned",
          "reserved",
          "off_hire_pending"
        ],
        "description": "Where the hire stands."
      },
      "hire_start": {
        "type": "string",
        "format": "date",
        "description": "First day of the hire."
      },
      "rental_days": {
        "type": "integer",
        "description": "Number of calendar days the equipment is on hire; determines the premium."
      },
      "site_postcode": {
        "type": "string",
        "description": "Postcode of the site where the equipment is used."
      },
      "operator_licence_no": {
        "type": "string",
        "description": "Licence number of the machine operator."
      }
    },
    "required": [
      "rental_id",
      "customer_name",
      "equipment_category",
      "damage_waiver",
      "hire_start",
      "rental_days"
    ]
  },
  "groundTruth": {
    "rental_id": {
      "source": "rental_no",
      "transform": "copy",
      "why": "rental number; line_id is the export row"
    },
    "customer_name": {
      "source": "customer",
      "transform": "trim",
      "why": "hirer, padded; depot_staff is the depot employee"
    },
    "customer_email": {
      "source": "email",
      "transform": "normalize_email",
      "why": "hirer email, mixed case, sometimes absent"
    },
    "equipment_category": {
      "source": "tool_group",
      "transform": "map_enum",
      "categoryMap": {
        "Mini Excavator": "excavator",
        "Scissor Lift": "aerial_platform",
        "Plate Compactor": "compaction",
        "Concrete Mixer": "mixing",
        "Scaffold Tower": "access_scaffold",
        "DEMO UNIT": null
      },
      "why": "equipment group; demo units are not hired out and need review"
    },
    "damage_waiver": {
      "source": "waiver",
      "transform": "map_enum",
      "categoryMap": {
        "Full cover": "full",
        "Basic (excess 500)": "basic",
        "Declined – own insurance": "declined"
      },
      "why": "waiver choice; payment_status is about payment"
    },
    "rental_status": {
      "source": "rental_status",
      "transform": "map_enum",
      "categoryMap": {
        "Out on hire": "on_hire",
        "Returned": "returned",
        "Reserved": "reserved",
        "Off-hire requested": "off_hire_pending"
      },
      "why": "hire state"
    },
    "hire_start": {
      "source": "start_date",
      "transform": "parse_date",
      "dateFormat": "MM/DD/YYYY",
      "why": "start (US month-first)"
    },
    "rental_days": {
      "source": null,
      "transform": "none",
      "why": "no hire length is exported; min_hire_days is the tariff minimum, not this hire's length",
      "unsupportedReason": "the length would have to be computed from end_date minus start_date"
    },
    "site_postcode": {
      "source": "site_postcode",
      "transform": "copy",
      "why": "site postcode, sometimes absent"
    },
    "operator_licence_no": {
      "source": null,
      "transform": "none",
      "why": "operator licences are not exported"
    }
  },
  "confusablePairs": [
    {
      "kind": "competing-category-fields",
      "fields": [
        "waiver",
        "payment_status"
      ],
      "correctFor": "damage_waiver"
    },
    {
      "kind": "competing-category-fields",
      "fields": [
        "rental_status",
        "payment_status"
      ],
      "correctFor": "rental_status"
    },
    {
      "kind": "customer-id-vs-transaction-id",
      "fields": [
        "rental_no",
        "line_id"
      ],
      "correctFor": "rental_id"
    },
    {
      "kind": "decoy-for-missing-field",
      "fields": [
        "min_hire_days",
        "daily_rate"
      ],
      "correctFor": "rental_days"
    },
    {
      "kind": "birth-date-vs-start-date",
      "fields": [
        "start_date",
        "end_date"
      ],
      "correctFor": "hire_start"
    }
  ],
  "sourceConcepts": {
    "rental_no": "transaction-id",
    "line_id": "other-identifier",
    "customer": "organization-name",
    "email": "email",
    "depot_staff": "person-name",
