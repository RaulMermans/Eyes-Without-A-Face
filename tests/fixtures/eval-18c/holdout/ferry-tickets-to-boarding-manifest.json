  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ticket_id": {
        "type": "string",
        "description": "Identifier of the individual ticket."
      },
      "passenger_name": {
        "type": "string",
        "description": "Full name of the passenger."
      },
      "passenger_email": {
        "type": "string",
        "format": "email",
        "description": "Email address of the passenger for delay notices."
      },
      "passenger_age": {
        "type": "integer",
        "description": "Age of the passenger in whole years on the sailing date."
      },
      "document_number": {
        "type": "string",
        "description": "Number of the identity document shown at boarding."
      },
      "sailing_date": {
        "type": "string",
        "format": "date",
        "description": "Date of the crossing."
      },
      "fare_class": {
        "type": "string",
        "enum": [
          "adult",
          "child",
          "senior",
          "student",
          "season_pass"
        ],
        "description": "Fare category of the ticket."
      },
      "vehicle_type": {
        "type": "string",
        "enum": [
          "none",
          "car",
          "motorcycle",
          "bicycle",
          "motorhome"
        ],
        "description": "Vehicle travelling with the passenger."
      },
      "boarding_status": {
        "type": "string",
        "enum": [
          "boarded",
          "no_show",
          "pending",
          "cancelled"
        ],
        "description": "Whether the passenger has boarded."
      },
      "fare_eur": {
        "type": "number",
        "description": "Ticket price in euros."
      }
    },
    "required": [
      "ticket_id",
      "passenger_name",
      "sailing_date",
      "fare_class",
      "boarding_status"
    ]
  },
  "groundTruth": {
    "ticket_id": {
      "source": "bilhete.codigo",
      "transform": "copy",
      "why": "ticket code; reserva.numero groups several tickets of one booking"
    },
    "passenger_name": {
      "source": "passageiro.nome_completo",
      "transform": "trim",
      "why": "passenger name, padded"
    },
    "passenger_email": {
      "source": "passageiro.email",
      "transform": "normalize_email",
      "why": "passenger email, mixed case, sometimes absent"
    },
    "passenger_age": {
      "source": null,
      "transform": "none",
      "why": "the export only has a birth date",
      "unsupportedReason": "the age would have to be computed from the birth date and the sailing date"
    },
    "document_number": {
      "source": "passageiro.documento.numero",
      "transform": "copy",
      "why": "identity document number"
    },
    "sailing_date": {
      "source": "data_viagem",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "travel date (Portuguese day-first); data_compra is the purchase timestamp"
    },
    "fare_class": {
      "source": "tipo_bilhete",
      "transform": "map_enum",
      "categoryMap": {
        "Adulto": "adult",
        "Criança (4-12)": "child",
        "Sénior +65": "senior",
        "Estudante": "student",
        "Passe Mensal": "season_pass",
        "Cortesia tripulação": null
      },
      "why": "fare type; crew courtesy tickets are not passenger fares and need review"
    },
    "vehicle_type": {
      "source": "veiculo.categoria",
      "transform": "map_enum",
      "categoryMap": {
        "Sem veículo": "none",
        "Ligeiro": "car",
        "Motociclo": "motorcycle",
        "Bicicleta": "bicycle",
        "Autocaravana": "motorhome"
      },
      "why": "vehicle category"
    },
    "boarding_status": {
      "source": "estado_embarque",
      "transform": "map_enum",
      "categoryMap": {
        "Embarcado": "boarded",
        "Não compareceu": "no_show",
        "Por embarcar": "pending",
        "Cancelado": "cancelled"
      },
      "why": "boarding state; estado_pagamento is about payment"
    },
    "fare_eur": {
      "source": "preco_bilhete",
      "transform": "copy",
      "why": "price in euros"
    }
  },
  "confusablePairs": [
    {
      "kind": "competing-category-fields",
      "fields": [
        "estado_embarque",
        "estado_pagamento"
      ],
      "correctFor": "boarding_status"
    },
    {
      "kind": "competing-category-fields",
      "fields": [
        "tipo_bilhete",
        "veiculo.categoria"
      ],
      "correctFor": "fare_class"
    },
    {
      "kind": "customer-id-vs-transaction-id",
      "fields": [
