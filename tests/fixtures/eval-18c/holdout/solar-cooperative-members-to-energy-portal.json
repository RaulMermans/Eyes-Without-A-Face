  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "member_id": {
        "type": "string",
        "description": "Membership number in the cooperative."
      },
      "member_name": {
        "type": "string",
        "description": "Full name of the member."
      },
      "member_email": {
        "type": "string",
        "format": "email",
        "description": "Email address of the member."
      },
      "member_phone": {
        "type": "string",
        "description": "Phone number of the member."
      },
      "meter_point_id": {
        "type": "string",
        "description": "14-digit delivery point identifier (PDL) of the member's own electricity meter, used to allocate self-consumption."
      },
      "share_class": {
        "type": "string",
        "enum": [
          "founder",
          "citizen",
          "local_authority",
          "employee"
        ],
        "description": "Class of shares held."
      },
      "installation_type": {
        "type": "string",
        "enum": [
          "school_roof",
          "carport",
          "farm_roof",
          "ground_mounted"
        ],
        "description": "Kind of installation the member invested in."
      },
      "membership_status": {
        "type": "string",
        "enum": [
          "active",
          "pending",
          "withdrawn"
        ],
        "description": "State of the membership."
      },
      "joined_on": {
        "type": "string",
        "format": "date",
        "description": "Date the member joined."
      },
      "shares_held": {
        "type": "integer",
        "description": "Number of shares held."
      },
      "iban_last4": {
        "type": "string",
        "description": "Last four characters of the member's IBAN."
      }
    },
    "required": [
      "member_id",
      "member_name",
      "member_email",
      "meter_point_id",
      "share_class",
      "membership_status",
      "joined_on"
    ]
  },
  "groundTruth": {
    "member_id": {
      "source": "adherent.numero",
      "transform": "copy",
      "why": "member number; id_export is a row id"
    },
    "member_name": {
      "source": "adherent.nom_complet",
      "transform": "trim",
      "why": "member name, padded"
    },
    "member_email": {
      "source": "adherent.coordonnees.courriel",
      "transform": "normalize_email",
      "why": "member email, mixed case"
    },
    "member_phone": {
      "source": "adherent.coordonnees.telephone",
      "transform": "copy",
      "why": "member phone, sometimes absent"
    },
    "meter_point_id": {
      "source": null,
      "transform": "none",
      "why": "the export has no meter point; installation.id_onduleur is the inverter of the shared installation"
    },
    "share_class": {
      "source": "parts.categorie",
      "transform": "map_enum",
      "categoryMap": {
        "Part A fondateur": "founder",
        "Part B citoyenne": "citizen",
        "Part C collectivité": "local_authority",
        "Part salarié": "employee"
      },
      "why": "share class"
    },
    "installation_type": {
      "source": "installation.type",
      "transform": "map_enum",
      "categoryMap": {
        "Toiture école": "school_roof",
        "Ombrière parking": "carport",
        "Toiture agricole": "farm_roof",
        "Sol (friche)": "ground_mounted"
      },
      "why": "installation kind"
    },
    "membership_status": {
      "source": "statut_adhesion",
      "transform": "map_enum",
      "categoryMap": {
        "Active": "active",
        "En cours de validation": "pending",
        "Radiée": "withdrawn",
        "Compte démo": null
      },
      "why": "membership state; demo accounts need review; statut_dividende is about dividends"
    },
    "joined_on": {
