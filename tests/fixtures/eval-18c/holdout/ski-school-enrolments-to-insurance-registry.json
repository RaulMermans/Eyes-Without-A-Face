  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "enrolment_id": {
        "type": "string",
        "description": "Number of the course enrolment."
      },
      "participant_name": {
        "type": "string",
        "description": "Full name of the insured participant."
      },
      "tax_code": {
        "type": "string",
        "description": "Italian fiscal code (codice fiscale, 16 characters) of the insured participant."
      },
      "level": {
        "type": "string",
        "enum": [
          "beginner",
          "snowplough",
          "parallel",
          "advanced",
          "racing"
        ],
        "description": "Skill level of the participant."
      },
      "course_type": {
        "type": "string",
        "enum": [
          "group_week",
          "private",
          "kids_club",
          "snowboard_group"
        ],
        "description": "Kind of course booked."
      },
      "course_start": {
        "type": "string",
        "format": "date",
        "description": "First day of the course; insurance cover starts here."
      },
      "guardian_email": {
        "type": "string",
        "format": "email",
        "description": "Email of the parent for minors."
      },
      "birth_date": {
        "type": "string",
        "format": "date",
        "description": "Date of birth of the participant."
      },
      "helmet_rental": {
        "type": "string",
        "description": "Whether a helmet is rented (yes/no)."
      }
    },
    "required": [
      "enrolment_id",
      "participant_name",
      "tax_code",
      "level",
      "course_type",
      "course_start"
    ]
  },
  "groundTruth": {
    "enrolment_id": {
      "source": "iscrizione.numero",
      "transform": "copy",
      "why": "enrolment number; riga is the export row"
    },
    "participant_name": {
      "source": "allievo.nome_cognome",
      "transform": "trim",
      "why": "pupil name, padded; maestro is the instructor"
    },
    "tax_code": {
      "source": null,
      "transform": "none",
      "why": "the export has no fiscal code; allievo.codice_skipass is the lift pass number"
    },
    "level": {
      "source": "livello",
      "transform": "map_enum",
      "categoryMap": {
        "Principiante": "beginner",
        "Spazzaneve": "snowplough",
        "Curve parallele": "parallel",
        "Avanzato": "advanced",
        "Agonista": "racing"
      },
      "why": "skill level"
    },
    "course_type": {
      "source": "tipo_corso",
      "transform": "map_enum",
      "categoryMap": {
        "Collettivo 6 giorni": "group_week",
        "Lezione privata": "private",
        "Baby club": "kids_club",
        "Snowboard collettivo": "snowboard_group",
        "Corso prova maestri": null
      },
      "why": "course kind; instructor trial courses need review"
    },
    "course_start": {
      "source": "data_inizio",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "course start (Italian day-first); iscrizione.data is the booking date"
    },
    "guardian_email": {
      "source": "genitore.email",
      "transform": "normalize_email",
      "why": "parent email, mixed case, sometimes absent"
    },
    "birth_date": {
      "source": "allievo.data_nascita",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "pupil birth date (Italian day-first), sometimes absent"
    },
    "helmet_rental": {
      "source": null,
      "transform": "none",
      "why": "rentals are not exported"
    }
  },
