      "why": "delivery number; id_riga is the export row and socio.codice the member"
    },
    "member_code": {
      "source": "socio.codice",
      "transform": "copy",
      "why": "member code"
    },
    "beekeeper_name": {
      "source": "socio.nominativo",
      "transform": "trim",
      "why": "member name, padded; assaggiatore is the taster"
    },
    "beekeeper_email": {
      "source": "socio.email",
      "transform": "normalize_email",
      "why": "member email, mixed case, sometimes absent"
    },
    "honey_type": {
      "source": "tipo_miele",
      "transform": "map_enum",
      "categoryMap": {
        "Millefiori": "wildflower",
        "Acacia": "acacia",
        "Castagno": "chestnut",
        "Tiglio": "linden",
        "Melata di bosco": "honeydew",
        "Sulla": "sulla"
      },
      "why": "honey variety"
    },
    "quality_grade": {
      "source": "classe_qualita",
      "transform": "map_enum",
      "categoryMap": {
        "Extra": "premium",
        "Prima scelta": "standard",
        "Uso industriale": "industrial",
        "Non conforme - campione": null
      },
      "why": "quality class; non-conforming samples need review; certificazione is organic status, not a grade"
    },
    "payment_status": {
      "source": "stato_pagamento",
      "transform": "map_enum",
      "categoryMap": {
        "Liquidato": "settled",
        "Da liquidare": "pending",
        "Acconto versato": "advance_paid"
      },
      "why": "settlement state"
    },
    "net_kg": {
      "source": "conferimento.peso_netto_kg",
      "transform": "copy",
      "why": "net weight; peso_lordo_kg includes the drums"
    },
    "delivered_on": {
      "source": "conferimento.data",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "delivery date (Italian day-first); data_smielatura is the extraction date"
    },
    "lot_number": {
      "source": null,
      "transform": "none",
      "why": "no lot number is exported"
    }
  },
