  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pupil_id": {
        "type": "string",
        "description": "School process number of the pupil."
      },
      "pupil_name": {
        "type": "string",
        "description": "Full name of the pupil, given name first."
      },
      "school_code": {
        "type": "string",
        "description": "Code of the school the pupil attends."
      },
      "guardian_email": {
        "type": "string",
        "format": "email",
        "description": "Email of the guardian for route changes."
      },
      "guardian_phone": {
        "type": "string",
        "description": "Mobile number of the guardian."
      },
      "shift": {
        "type": "string",
        "enum": [
          "morning",
          "afternoon",
          "both",
          "return_only"
        ],
        "description": "Which runs the pupil rides."
      },
      "subsidy_tier": {
        "type": "string",
        "enum": [
          "full",
          "partial",
          "reduced",
          "no_subsidy"
        ],
        "description": "School social support tier that determines the transport subsidy."
      },
      "enrolment_status": {
        "type": "string",
        "enum": [
          "active",
          "pending",
          "cancelled"
        ],
        "description": "State of the transport enrolment."
      },
      "stop_code": {
        "type": "string",
        "description": "Code of the boarding stop."
      },
      "service_start": {
        "type": "string",
        "format": "date",
        "description": "First day of transport."
      },
      "wheelchair_access_needed": {
        "type": "string",
        "description": "Whether the pupil needs a wheelchair-accessible vehicle (yes/no)."
      }
    },
    "required": [
      "pupil_id",
      "pupil_name",
      "school_code",
      "guardian_email",
      "shift",
      "enrolment_status",
      "stop_code",
      "service_start"
    ]
  },
  "groundTruth": {
    "pupil_id": {
      "source": "aluno.numero_processo",
      "transform": "copy",
      "why": "pupil process number; id_registo is the export row"
    },
    "pupil_name": {
      "source": null,
      "sources": [
        "aluno.nome_proprio",
        "aluno.apelido"
      ],
      "transform": "concat",
      "separator": " ",
      "why": "pupil first name plus surname; encarregado.nome is the guardian"
    },
    "school_code": {
      "source": "escola.codigo",
      "transform": "copy",
      "why": "school code, not the school name"
    },
    "guardian_email": {
      "source": "encarregado.email",
      "transform": "normalize_email",
      "why": "guardian email, mixed case"
    },
    "guardian_phone": {
      "source": "encarregado.telemovel",
      "transform": "copy",
      "why": "guardian mobile, sometimes absent"
    },
    "shift": {
      "source": "turno",
      "transform": "map_enum",
      "categoryMap": {
        "Manhã": "morning",
        "Tarde": "afternoon",
        "Manhã + Tarde": "both",
        "Só regresso": "return_only"
      },
      "why": "runs used"
    },
    "subsidy_tier": {
      "source": "escalao_ase",
      "transform": "map_enum",
      "categoryMap": {
        "Escalão A": "full",
        "Escalão B": "partial",
        "Escalão C": "reduced",
        "Sem escalão": "no_subsidy"
      },
      "why": "ASE support tier"
    },
    "enrolment_status": {
      "source": "estado_inscricao",
      "transform": "map_enum",
      "categoryMap": {
        "Ativa": "active",
        "Pendente documentos": "pending",
        "Cancelada": "cancelled",
        "Duplicada - verificar": null
      },
      "why": "enrolment state; suspected duplicates need review; estado_pagamento is about fees"
    },
    "stop_code": {
      "source": "paragem.codigo",
      "transform": "copy",
      "why": "stop code"
    },
    "service_start": {
      "source": "data_inicio",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "start of service (Portuguese day-first); rows without it must be held"
    },
    "wheelchair_access_needed": {
      "source": null,
      "transform": "none",
      "why": "accessibility needs are not exported"
    }
  },
  "confusablePairs": [
    {
      "kind": "competing-category-fields",
