  "destination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "booking_id": {
        "type": "string",
        "description": "Identifier of the booking."
      },
      "dog_name": {
        "type": "string",
        "description": "Name of the dog."
      },
      "microchip_number": {
        "type": "string",
        "description": "15-digit ISO 11784 transponder number of the dog's implanted microchip."
      },
      "size_class": {
        "type": "string",
        "enum": [
          "toy",
          "small",
          "medium",
          "large",
          "giant"
        ],
        "description": "Size class used for group allocation."
      },
      "service": {
        "type": "string",
        "enum": [
          "daycare_full_day",
          "daycare_half_day",
          "overnight",
          "walk"
        ],
        "description": "Service booked."
      },
      "status": {
        "type": "string",
        "enum": [
          "confirmed",
          "checked_in",
          "no_show",
          "cancelled"
        ],
        "description": "Attendance state of the booking."
      },
      "owner_name": {
        "type": "string",
        "description": "Name of the dog owner."
      },
      "owner_email": {
        "type": "string",
        "format": "email",
        "description": "Email of the dog owner."
      },
      "check_in": {
        "type": "string",
        "format": "date",
        "description": "Day the dog is dropped off."
      },
      "vaccination_valid_until": {
        "type": "string",
        "format": "date",
        "description": "Expiry of the dog's rabies vaccination."
      }
    },
    "required": [
      "booking_id",
      "dog_name",
      "microchip_number",
      "size_class",
      "service",
      "owner_name",
      "check_in"
    ]
  },
  "groundTruth": {
    "booking_id": {
      "source": "reserva_id",
      "transform": "copy",
      "why": "booking id; row_num is the export row"
    },
    "dog_name": {
      "source": "perro.nombre",
      "transform": "copy",
      "why": "dog name"
    },
    "microchip_number": {
      "source": null,
      "transform": "none",
      "why": "the export has no microchip number; perro.placa_collar is the daycare's own collar tag"
    },
    "size_class": {
      "source": "perro.tamano",
      "transform": "map_enum",
      "categoryMap": {
        "Mini (<5kg)": "toy",
        "Pequeño": "small",
        "Mediano": "medium",
        "Grande": "large",
        "Gigante (+45kg)": "giant"
      },
      "why": "size class"
    },
    "service": {
      "source": "servicio",
      "transform": "map_enum",
      "categoryMap": {
        "Guardería día": "daycare_full_day",
        "Media jornada": "daycare_half_day",
        "Hotel noche": "overnight",
        "Paseo 1h": "walk",
        "Prueba adaptación": null
      },
      "why": "service; free adaptation trials need review"
    },
    "status": {
      "source": "booking_status",
      "transform": "map_enum",
      "categoryMap": {
        "Confirmed": "confirmed",
        "Checked in": "checked_in",
        "No show": "no_show",
        "Cancelled": "cancelled"
      },
      "why": "booking state; estado_pago is payment"
    },
    "owner_name": {
      "source": "owner.name",
      "transform": "trim",
      "why": "owner, padded; walker is staff"
    },
    "owner_email": {
      "source": "owner.email",
      "transform": "normalize_email",
      "why": "owner email, mixed case, sometimes absent"
    },
    "check_in": {
      "source": "check_in_fecha",
      "transform": "parse_date",
      "dateFormat": "DD/MM/YYYY",
      "why": "check-in date (Spanish day-first); fecha_nacimiento is the dog's birth date"
    },
    "vaccination_valid_until": {
      "source": null,
      "transform": "none",
      "why": "vaccination records are not exported"
    }
  },
  "confusablePairs": [
    {
      "kind": "competing-category-fields",
      "fields": [
