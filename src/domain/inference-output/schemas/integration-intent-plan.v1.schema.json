{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyes-without-a-face.dev/schemas/integration-intent-plan/1.0.0",
  "title": "Integration Intent Plan 1.0.0 (alias-level model output, ADR 0018)",
  "description": "One entry per destination field: which disclosed aliases correspond to it (the correspondence) and, separately, how to transform them (the transformation). Closed vocabularies only; no free text per field. Never executable. Validated by src/plan/validate.ts and compiled by src/plan/compile.ts through the unchanged convertProposal gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fields", "summary"],
  "properties": {
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "status", "from", "transform", "confidence", "evidence", "missing"],
        "properties": {
          "target": { "type": "string", "minLength": 1, "maxLength": 128 },
          "status": { "enum": ["ready", "needs_clarification", "unsupported", "no_source"] },
          "from": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^f_[0-9]{2,3}$" }
          },
          "transform": { "enum": ["copy", "trim", "normalize_email", "parse_date", "map_enum", "concat", "none"] },
          "inputFormat": { "enum": ["ISO-8601", "YYYY-MM-DD", "MM/DD/YYYY", "DD/MM/YYYY"] },
          "separator": { "type": "string", "maxLength": 16 },
          "valueMap": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "confidence": { "enum": ["high", "medium", "low"] },
          "evidence": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "enum": ["meaning", "type", "format", "examples", "category-labels", "name-pattern"] }
          },
          "missing": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "category-labels",
                "date-order",
                "field-meaning",
                "business-rule",
                "destination-value",
                "no-matching-source",
                "unsupported-transform"
              ]
            }
          }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 280 }
  }
}
