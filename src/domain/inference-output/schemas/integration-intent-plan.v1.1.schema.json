{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyes-without-a-face.dev/schemas/integration-intent-plan/1.1.0",
  "title": "Integration Intent Plan 1.1.0 (ranked alternatives, ADR 0021)",
  "description": "Plan 1.0.0 plus `alternatives`: up to two other disclosed aliases that could carry the same meaning, most likely first (answer to prompt v6). Alternatives are candidates for a question, never executed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fields",
    "summary"
  ],
  "properties": {
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "status",
          "from",
          "transform",
          "confidence",
          "evidence",
          "missing"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "ready",
              "needs_clarification",
              "unsupported",
              "no_source"
            ]
          },
          "from": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^f_[0-9]{2,3}$"
            }
          },
          "transform": {
            "enum": [
              "copy",
              "trim",
              "normalize_email",
              "parse_date",
              "map_enum",
              "concat",
              "none"
            ]
          },
          "inputFormat": {
            "enum": [
              "ISO-8601",
              "YYYY-MM-DD",
              "MM/DD/YYYY",
              "DD/MM/YYYY"
            ]
          },
          "separator": {
            "type": "string",
            "maxLength": 16
          },
          "valueMap": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "meaning",
                "type",
                "format",
                "examples",
                "category-labels",
                "name-pattern"
              ]
            }
          },
          "missing": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "category-labels",
                "date-order",
                "field-meaning",
                "business-rule",
                "destination-value",
                "no-matching-source",
                "unsupported-transform"
              ]
            }
          },
          "alternatives": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^f_[0-9]{2,3}$"
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    }
  }
}
