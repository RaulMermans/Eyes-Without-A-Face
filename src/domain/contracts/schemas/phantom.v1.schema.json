{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyes-without-a-face.dev/schemas/phantom/1.0.0",
  "title": "Phantom Contract",
  "description": "Synthetic representation approved for cloud reasoning. Must not embed private source records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractKind",
    "schemaVersion",
    "phantomId",
    "sourceDatasetId",
    "entities",
    "fields",
    "syntheticExamples",
    "shareableFieldAliases",
    "nonShareableSourceFieldIds"
  ],
  "properties": {
    "contractKind": { "const": "phantom" },
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "phantomId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceDatasetId": { "type": "string", "minLength": 1 },
    "approvedForCloud": { "type": "boolean" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phantomField" }
    },
    "syntheticExamples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
      }
    },
    "disclosureConstraints": {
      "type": "array",
      "items": { "type": "string", "maxLength": 512 }
    },
    "shareableFieldAliases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonShareableSourceFieldIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "phantomField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "entityId", "type", "shareable", "semanticDescriptor"],
      "properties": {
        "alias": { "type": "string", "minLength": 1, "maxLength": 128 },
        "entityId": { "type": "string", "minLength": 1 },
        "sourceFieldId": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["string", "number", "integer", "boolean", "date", "datetime", "enum"]
        },
        "shareable": { "type": "boolean" },
        "semanticDescriptor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "Abstract meaning only. Must not contain raw private values."
        },
        "enumValues": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
