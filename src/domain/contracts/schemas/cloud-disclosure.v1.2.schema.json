{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyes-without-a-face.dev/schemas/cloud-disclosure/1.2.0",
  "title": "Cloud Disclosure Payload (1.2.0, blind revision request)",
  "description": "Blind revision request. Identical to the approved 1.1.0 disclosure (fields, entities, examples, constraints, target) plus a required `revision` block carrying one BlindRevisionFeedback 1.0.0. Validated, previewed, approved and dispatched through the same single-use gate as 1.1.0. Never contains record values, source field names or local bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractKind",
    "schemaVersion",
    "payloadId",
    "phantomId",
    "destination",
    "purpose",
    "entities",
    "fields",
    "syntheticExamples",
    "target",
    "revision"
  ],
  "properties": {
    "contractKind": {
      "const": "cloud-disclosure"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.2.0"
    },
    "payloadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "phantomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Twin identifier only. Must not be a private source dataset id field."
    },
    "destination": {
      "$ref": "#/$defs/destination"
    },
    "purpose": {
      "type": "string",
      "const": "mapping-proposal"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 280
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/disclosureField"
      }
    },
    "syntheticExamples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    },
    "disclosureConstraints": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 280
      }
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback"
      ],
      "properties": {
        "feedback": {
          "$ref": "https://eyes-without-a-face.dev/schemas/blind-revision-feedback/1.0.0"
        }
      }
    }
  },
  "$defs": {
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "backend",
        "model",
        "purpose"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "firebase-ai-logic"
        },
        "backend": {
          "type": "string",
          "const": "google-ai"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "purpose": {
          "type": "string",
          "const": "mapping-proposal"
        }
      }
    },
    "disclosureField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "entityId",
        "type",
        "semanticDescriptor"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "date",
            "datetime",
            "enum"
          ]
        },
        "semanticDescriptor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "enumValues": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 32
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/targetField"
          }
        }
      }
    },
    "targetField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,3}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "enum"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "nullable": {
          "type": "boolean"
        },
        "format": {
          "type": "string",
          "enum": [
            "email",
            "date",
            "date-time",
            "uri",
            "uuid"
          ]
        },
        "enumValues": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  }
}
