{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyes-without-a-face.dev/schemas/validation/1.0.0",
  "title": "Validation Contract",
  "description": "Local verification results for a mapping version. Diagnostics must not include raw private records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractKind",
    "schemaVersion",
    "reportId",
    "mappingId",
    "mappingVersion",
    "results"
  ],
  "properties": {
    "contractKind": { "const": "validation" },
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "reportId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mappingId": { "type": "string", "minLength": 1 },
    "mappingVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testId", "status", "expected", "observed"],
      "properties": {
        "testId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "expected": { "type": "object" },
        "observed": { "type": "object" },
        "failureCode": {
          "type": "string",
          "enum": [
            "FIELD_MISSING",
            "TYPE_MISMATCH",
            "ENUM_UNMAPPED",
            "CONSTRAINT_VIOLATION",
            "DATE_PARSE_FAILED",
            "UNEXPECTED_VALUE"
          ]
        },
        "diagnostic": {
          "type": "string",
          "maxLength": 512,
          "description": "Safe diagnostic. Must not echo private source payloads."
        },
        "reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixtureId"],
          "properties": {
            "fixtureId": { "type": "string", "minLength": 1 },
            "seed": { "type": "integer" }
          }
        }
      }
    }
  }
}
