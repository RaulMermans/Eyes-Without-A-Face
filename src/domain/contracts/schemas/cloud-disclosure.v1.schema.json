{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyes-without-a-face.dev/schemas/cloud-disclosure/1.0.0",
  "title": "Cloud Disclosure Payload",
  "description": "Allowlisted outbound payload for cloud inference. Constructed by projection, never by serializing a Phantom Contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractKind",
    "schemaVersion",
    "payloadId",
    "phantomId",
    "destination",
    "purpose",
    "entities",
    "fields",
    "syntheticExamples"
  ],
  "properties": {
    "contractKind": { "const": "cloud-disclosure" },
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "payloadId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "phantomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Twin identifier only. Must not be a private source dataset id field."
    },
    "destination": { "$ref": "#/$defs/destination" },
    "purpose": { "type": "string", "const": "mapping-proposal" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "label": { "type": "string", "minLength": 1, "maxLength": 128 },
          "description": { "type": "string", "maxLength": 280 }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/disclosureField" }
    },
    "syntheticExamples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
      }
    },
    "disclosureConstraints": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 280 }
    }
  },
  "$defs": {
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "backend", "model", "purpose"],
      "properties": {
        "provider": { "type": "string", "const": "firebase-ai-logic" },
        "backend": { "type": "string", "const": "google-ai" },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "purpose": { "type": "string", "const": "mapping-proposal" }
      }
    },
    "disclosureField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "entityId", "type", "semanticDescriptor"],
      "properties": {
        "alias": { "type": "string", "minLength": 1, "maxLength": 128 },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": {
          "type": "string",
          "enum": ["string", "number", "integer", "boolean", "date", "datetime", "enum"]
        },
        "semanticDescriptor": { "type": "string", "minLength": 1, "maxLength": 280 },
        "enumValues": {
          "type": "array",
          "items": { "type": "string", "maxLength": 64 },
          "maxItems": 32
        }
      }
    }
  }
}
