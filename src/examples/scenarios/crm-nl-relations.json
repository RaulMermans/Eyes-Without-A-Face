{
  "scenarioId": "crm-nl-relations",
  "scenarioVersion": "1.0.0",
  "title": "Dutch CRM relations → helpdesk requesters",
  "summary": "Dutch field names that English profiling rules cannot read: which text field is the company and which the contact person, and whether customer-since dates are day-first.",
  "difficulty": [
    "Non-English field names: 'bedrijf' (company) and 'contactpersoon' (contact person) both look like plain text to the deterministic role rules, so the twin cannot tell the cloud which alias is the organization and which the person.",
    "Ambiguous DD/MM vs MM/DD dates: every imported 'sinds' value has day and month ≤ 12, so profiling cannot prove the order. The source is a Dutch CRM; the true order is day-first.",
    "Lifecycle stage 'fase' uses Dutch labels; the owner declares their meaning. An unseen stage may be filed as 'other'."
  ],
  "fictional": true,
  "localOnly": true,
  "canaries": ["PRIVATE_CANARY_PII_DO_NOT_SHARE"],
  "datasetLabel": "crm-nl-relations",
  "twinOverrides": {
    "fase": { "discloseCategories": true },
    "opmerking": { "shareable": false }
  },
  "destinationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://eyes-without-a-face.dev/examples/scenarios/crm-nl/destination/1.0.0",
    "title": "Helpdesk requester directory",
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "email", "status", "customerSince", "organization", "contactName"],
    "properties": {
      "id": { "type": "string", "pattern": "^RL-[0-9]{5}$" },
      "email": { "type": "string", "format": "email" },
      "status": { "enum": ["customer", "former", "lead", "other"] },
      "customerSince": { "type": "string", "format": "date" },
      "organization": { "type": "string", "minLength": 1 },
      "contactName": { "type": "string", "minLength": 1 }
    }
  },
  "policy": {
    "policyVersion": "1.0.0",
    "policyId": "crm-nl-v1",
    "description": "Unusable contact emails go to manual review. Unknown relation stages may be filed as 'other'.",
    "quarantine": [
      { "code": "INVALID_EMAIL", "to": "email" },
      { "code": "NULL_VALUE", "to": "email" },
      { "code": "TYPE_MISMATCH", "to": "email" },
      { "code": "OUTPUT_SCHEMA_MISMATCH", "to": "email" }
    ],
    "approvedFallbacks": [{ "to": "status", "value": "other", "appliesTo": "undisclosed-category" }],
    "approvedDefaults": [],
    "maxQuarantineRate": 0.34
  },
  "imported": [
    { "record": { "relatienr": "RL-20001", "mailadres": "sanne.devries@example.nl", "fase": "klant", "sinds": "04/03/2024", "bedrijf": "Bakkerij De Vries", "contactpersoon": "Sanne de Vries", "opmerking": "PRIVATE_CANARY_PII_DO_NOT_SHARE fictional payment arrangement, keep local" }, "expected": { "kind": "transform", "output": { "id": "RL-20001", "email": "sanne.devries@example.nl", "status": "customer", "customerSince": "2024-03-04", "organization": "Bakkerij De Vries", "contactName": "Sanne de Vries" } } },
    { "record": { "relatienr": "RL-20002", "mailadres": "pieter.bakker@example.nl", "fase": "klant", "sinds": "11/01/2023", "bedrijf": "Bakker Installatietechniek", "contactpersoon": "Pieter Bakker", "opmerking": "Fictional, prefers phone" }, "expected": { "kind": "transform", "output": { "id": "RL-20002", "email": "pieter.bakker@example.nl", "status": "customer", "customerSince": "2023-01-11", "organization": "Bakker Installatietechniek", "contactName": "Pieter Bakker" } } },
    { "record": { "relatienr": "RL-20003", "mailadres": "fatima.elamrani@example.nl", "fase": "lead", "sinds": "07/09/2025", "bedrijf": "Studio Noord", "contactpersoon": "Fatima El Amrani", "opmerking": "Fictional trade-fair lead" }, "expected": { "kind": "transform", "output": { "id": "RL-20003", "email": "fatima.elamrani@example.nl", "status": "lead", "customerSince": "2025-09-07", "organization": "Studio Noord", "contactName": "Fatima El Amrani" } } },
    { "record": { "relatienr": "RL-20004", "mailadres": "joost.visser@example.be", "fase": "oud-klant", "sinds": "02/12/2021", "bedrijf": "Visser & Zonen Transport", "contactpersoon": "Joost Visser", "opmerking": "Fictional, contract ended" }, "expected": { "kind": "transform", "output": { "id": "RL-20004", "email": "joost.visser@example.be", "status": "former", "customerSince": "2021-12-02", "organization": "Visser & Zonen Transport", "contactName": "Joost Visser" } } },
    { "record": { "relatienr": "RL-20005", "mailadres": "lotte.meijer@example.nl", "fase": "klant", "sinds": "10/06/2022", "bedrijf": "Tandartspraktijk Meijer", "contactpersoon": "Lotte Meijer", "opmerking": "Fictional dental practice" }, "expected": { "kind": "transform", "output": { "id": "RL-20005", "email": "lotte.meijer@example.nl", "status": "customer", "customerSince": "2022-06-10", "organization": "Tandartspraktijk Meijer", "contactName": "Lotte Meijer" } } },
