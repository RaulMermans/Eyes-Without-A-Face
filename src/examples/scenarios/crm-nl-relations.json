  ],
  "revisionFeedback": [
    { "record": { "relatienr": "RL-20031", "mailadres": "eva.mulder@example.nl", "fase": "klant", "sinds": "23/02/2024", "bedrijf": "Mulder Fietsen", "contactpersoon": "Eva Mulder" }, "expected": { "kind": "transform", "output": { "id": "RL-20031", "email": "eva.mulder@example.nl", "status": "customer", "customerSince": "2024-02-23", "organization": "Mulder Fietsen", "contactName": "Eva Mulder" } } },
    { "record": { "relatienr": "RL-20032", "mailadres": "ruben.bos@example.nl", "fase": "partner", "sinds": "09/03/2023", "bedrijf": "Bos ICT", "contactpersoon": "Ruben Bos" }, "expected": { "kind": "fallback", "output": { "id": "RL-20032", "email": "ruben.bos@example.nl", "status": "other", "customerSince": "2023-03-09", "organization": "Bos ICT", "contactName": "Ruben Bos" } } },
    { "record": { "relatienr": "RL-20033", "mailadres": "onbekend", "fase": "klant", "sinds": "01/04/2024", "bedrijf": "Zonder Mail BV", "contactpersoon": "Kees Jansen" }, "expected": { "kind": "quarantine" } }
  ],
  "semanticSpec": {
    "specVersion": "1.0.0",
    "note": "Fictional owner declarations, made before any Sprint 12 model run. Neither the date order of 'sinds' nor which text field is the company is declared: that is what the Sprint 12 Nano-value experiment asks.",
    "declared": [
      {
        "id": "crm-nl-stage-meaning",
        "kind": "enum-meaning",
        "source": "fase",
        "target": "status",
        "meaning": { "klant": "customer", "oud-klant": "former", "lead": "lead" },
        "undeclared": "unconstrained",
        "trust": "trusted",
        "evidence": { "kind": "user-declared" }
      }
    ]
  },
  "development": [
