{
  "scenarioId": "billing-subscriptions",
  "scenarioVersion": "1.0.0",
  "title": "Subscription billing",
  "summary": "Plans, subscription states, renewal dates and monthly amounts, with states and amount formats the imported sample does not show.",
  "difficulty": [
    "'trialing' must map to 'trial'.",
    "Unknown subscription states may only use the approved fallback 'unknown'; unknown plans must not be guessed.",
    "String amounts and impossible calendar dates cannot be fixed by any of the eight operations."
  ],
  "fictional": true,
  "localOnly": true,
  "canaries": [
    "PRIVATE_CANARY_PII_DO_NOT_SHARE"
  ],
  "datasetLabel": "billing-subscriptions",
  "twinOverrides": {
    "plan": {
      "discloseCategories": true
    },
    "state": {
      "discloseCategories": true
    },
    "internal_memo": {
      "shareable": false
    }
  },
  "destinationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://eyes-without-a-face.dev/examples/scenarios/billing/destination/1.0.0",
    "title": "Subscription ledger",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "billingEmail",
      "plan",
      "status",
      "renewsOn",
      "monthlyAmount"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^SUB-[0-9]{4}$"
      },
      "billingEmail": {
        "type": "string",
        "format": "email"
      },
      "plan": {
        "enum": [
          "basic",
          "pro",
          "team",
          "enterprise"
        ]
      },
      "status": {
        "enum": [
          "active",
          "trial",
          "canceled",
          "past_due",
          "unknown"
        ]
      },
      "renewsOn": {
        "type": "string",
        "format": "date"
      },
      "monthlyAmount": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "policy": {
    "policyVersion": "1.0.0",
    "policyId": "billing-v1",
    "description": "Unknown subscription states may be filed as 'unknown'. Unknown plans, non-numeric amounts, impossible dates and missing billing emails go to manual review.",
    "quarantine": [
      {
        "code": "UNMAPPED_ENUM",
        "to": "plan"
      },
      {
        "code": "OUTPUT_SCHEMA_MISMATCH",
        "to": "monthlyAmount"
      },
      {
        "code": "TYPE_MISMATCH",
        "to": "monthlyAmount"
      },
      {
        "code": "INVALID_DATE",
        "to": "renewsOn"
      },
      {
        "code": "NULL_VALUE",
        "to": "billingEmail"
      },
      {
        "code": "INVALID_EMAIL",
        "to": "billingEmail"
      },
      {
        "code": "OUTPUT_SCHEMA_MISMATCH",
        "to": "billingEmail"
      }
    ],
    "approvedFallbacks": [
      {
        "to": "status",
        "value": "unknown",
        "appliesTo": "undisclosed-category"
      }
    ],
    "approvedDefaults": [],
    "maxQuarantineRate": 0.34
  },
