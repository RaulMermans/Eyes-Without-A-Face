{
  "scenarioId": "support-tickets",
  "scenarioVersion": "2.0.0",
  "title": "Support tickets",
  "summary": "Priority codes, requester emails and ticket references that are clean in the imported sample but padded or mixed-case in hidden cases.",
  "difficulty": [
    "Ticket references and emails with surrounding whitespace only appear in hidden cases.",
    "Priorities p1–p4 must be interpreted (p1 → urgent); an unknown priority must never be guessed.",
    "Date-only timestamps cannot become valid date-times without inventing a time."
  ],
  "fictional": true,
  "localOnly": true,
  "canaries": [
    "PRIVATE_CANARY_PII_DO_NOT_SHARE"
  ],
  "datasetLabel": "support-tickets",
  "twinOverrides": {
    "prio": {
      "discloseCategories": true
    },
    "channel": {
      "discloseCategories": true
    },
    "body": {
      "shareable": false
    }
  },
  "destinationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://eyes-without-a-face.dev/examples/scenarios/support/destination/1.0.0",
    "title": "Helpdesk ticket",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "requesterEmail",
      "priority",
      "openedAt",
      "channel"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^TCK-[0-9]{4}$"
      },
      "requesterEmail": {
        "type": "string",
        "format": "email"
      },
      "priority": {
        "enum": [
          "urgent",
          "high",
          "normal",
          "low"
        ]
      },
      "openedAt": {
        "type": "string",
        "format": "date-time"
      },
      "channel": {
        "enum": [
          "email",
          "phone",
          "web",
          "chat"
        ]
      }
    }
  },
  "policy": {
    "policyVersion": "1.0.0",
    "policyId": "support-v1",
    "description": "Never guess urgency or channel: unknown priorities and channels go to manual review, as do tickets without a usable timestamp or requester email.",
    "quarantine": [
      {
        "code": "UNMAPPED_ENUM",
        "to": "priority"
      },
      {
        "code": "UNMAPPED_ENUM",
        "to": "channel"
      },
      {
        "code": "OUTPUT_SCHEMA_MISMATCH",
        "to": "openedAt"
      },
      {
        "code": "INVALID_EMAIL",
        "to": "requesterEmail"
      }
    ],
    "approvedFallbacks": [],
    "approvedDefaults": [],
    "maxQuarantineRate": 0.34
  },
