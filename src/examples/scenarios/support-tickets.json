  "semanticSpec": {
    "specVersion": "1.0.0",
    "note": "Fictional owner declarations, made before any Sprint 8 model run: p1 is the most urgent priority code and p4 the least urgent; channel labels keep their names; anything undeclared goes to review.",
    "declared": [
      {
        "id": "support-priority-order",
        "kind": "ordered-categories",
        "source": "prio",
        "target": "priority",
        "sourceOrder": [
          "p1",
          "p2",
          "p3",
          "p4"
        ],
        "targetOrder": [
          "urgent",
          "high",
          "normal",
          "low"
        ],
        "undeclared": "review",
        "trust": "trusted",
        "evidence": {
          "kind": "user-declared"
        }
      },
      {
        "id": "support-channel-meaning",
        "kind": "enum-meaning",
        "source": "channel",
        "target": "channel",
        "meaning": {
          "email": "email",
          "phone": "phone",
          "web": "web"
        },
        "undeclared": "review",
        "trust": "trusted",
        "evidence": {
          "kind": "user-declared"
        }
      }
    ]
  },
