  "semanticSpec": {
    "specVersion": "1.0.0",
    "note": "Fictional owner declarations, made before any Sprint 8 model run. The date order of angelegt_am is NOT declared: the local verifier must establish it from evidence or report it as ambiguous.",
    "declared": [
      {
        "id": "crm-status-meaning",
        "kind": "enum-meaning",
        "source": "kontostatus",
        "target": "status",
        "meaning": {
          "aktiv": "active",
          "inaktiv": "inactive",
          "interessent": "prospect"
        },
        "undeclared": "unconstrained",
        "trust": "trusted",
        "evidence": {
          "kind": "user-declared"
        }
      }
    ]
  },
