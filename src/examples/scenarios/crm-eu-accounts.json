{
  "scenarioId": "crm-eu-accounts",
  "scenarioVersion": "2.0.0",
  "title": "Customer CRM (EU accounts)",
  "summary": "German field names, translated account states, and slash dates whose day/month order the imported sample cannot prove.",
  "difficulty": [
    "Ambiguous DD/MM vs MM/DD dates: imported days are all ≤ 12, so profiling assumes MM/DD/YYYY and silently swaps day and month.",
    "Account states must be translated (aktiv → active).",
    "A company-name field whose name the deterministic profiler does not recognise.",
    "Unknown account states may only use the owner-approved fallback 'other'."
  ],
  "fictional": true,
  "localOnly": true,
  "canaries": [
    "PRIVATE_CANARY_PII_DO_NOT_SHARE"
  ],
  "datasetLabel": "crm-eu-accounts",
  "twinOverrides": {
    "kontostatus": {
      "discloseCategories": true
    },
    "notiz": {
      "shareable": false
    }
  },
  "destinationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://eyes-without-a-face.dev/examples/scenarios/crm-eu/destination/1.0.0",
    "title": "Account directory",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "email",
      "status",
      "createdAt",
      "organization"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^KD-[0-9]{5}$"
      },
      "email": {
        "type": "string",
        "format": "email"
      },
      "status": {
        "enum": [
          "active",
          "inactive",
          "prospect",
          "other"
        ]
      },
      "createdAt": {
        "type": "string",
        "format": "date"
      },
      "organization": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "policy": {
    "policyVersion": "1.0.0",
    "policyId": "crm-eu-v1",
    "description": "Unusable contact emails go to manual review. Unknown account states may be filed as 'other'.",
    "quarantine": [
      {
        "code": "INVALID_EMAIL",
        "to": "email"
      },
      {
        "code": "NULL_VALUE",
        "to": "email"
      },
      {
        "code": "TYPE_MISMATCH",
        "to": "email"
      },
      {
        "code": "OUTPUT_SCHEMA_MISMATCH",
        "to": "email"
      }
    ],
    "approvedFallbacks": [
      {
        "to": "status",
        "value": "other",
        "appliesTo": "undisclosed-category"
      }
    ],
    "approvedDefaults": [],
    "maxQuarantineRate": 0.34
  },
