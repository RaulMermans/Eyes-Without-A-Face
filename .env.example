# Public Firebase web configuration (safe to expose in the browser).
# These are not service-account secrets. Leave blank for local Sprint 0 work.
# Copy to .env.local if you need values; never commit .env.local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Feature flags. Keep false until Sprint 1 live adapters are implemented.
# Missing configuration must never fall back to another cloud provider.
VITE_ENABLE_ON_DEVICE_INFERENCE=false
VITE_ENABLE_CLOUD_INFERENCE=false

# App Check
# Production: register a reCAPTCHA Enterprise provider and set the site key.
# Development: do NOT put App Check debug tokens in VITE_* variables.
# Set self.FIREBASE_APPCHECK_DEBUG_TOKEN in a private local-only script.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_APP_CHECK_DEBUG=false
