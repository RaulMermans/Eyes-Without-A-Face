# Public Firebase web configuration (safe to expose in the browser).
# These are not service-account secrets. Copy this file to .env.local (gitignored).
# Never commit .env, .env.local, or App Check debug tokens.

# Registered web app: eyes-without-a-face-web
# Project ID: eyes-without-a-face-b7281
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Feature flags. Enable only after Firebase + App Check are ready.
# Missing configuration must never fall back to another cloud provider.
VITE_ENABLE_ON_DEVICE_INFERENCE=false
VITE_ENABLE_CLOUD_INFERENCE=false

# App Check (reCAPTCHA Enterprise site key — public, not the secret key).
# Production: registered Fraud Defense / reCAPTCHA Enterprise provider.
# Development: keep the site key, set VITE_APP_CHECK_DEBUG=true, then safelist
# the debug token printed in the browser console (Firebase Console → App Check
# → Apps → Manage debug tokens). Never put that token in any VITE_* variable.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_APP_CHECK_DEBUG=false
