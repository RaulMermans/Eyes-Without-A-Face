{
  "name": "eyes-without-a-face",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:release": "node scripts/build-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "preview": "vite preview",
    "lint": "oxlint .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json --pretty false",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:privacy": "vitest run tests/privacy",
    "test:mapping": "vitest run tests/unit/mapping-engine.test.ts tests/unit/mapping-operations.test.ts tests/contracts/mapping-execution.test.ts tests/privacy/mapping-privacy.test.ts",
    "test:e2e": "playwright test",
    "test:live": "playwright test -c playwright.live.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:production": "playwright test -c playwright.production.config.ts",
    "test:production:real": "playwright test -c playwright.production-real.config.ts",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:contracts && pnpm test:privacy && pnpm test:evaluation && pnpm build && pnpm test:e2e",
    "test:evaluation": "vitest run tests/evaluation"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "papaparse": "5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
